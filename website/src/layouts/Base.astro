---
import '../styles/global.css';
import { SITE } from '../lib/site';
import Search from '../components/Search.astro';
import HoverCard from '../components/HoverCard.astro';

interface Props {
  title?: string;
  description?: string;
  og?: string;
  section?: string;
}
const { title, description = SITE.description, og = '/og/vue-groupes.png', section } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ce que font vos élus, en chiffres`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogUrl = new URL(og, SITE.url).href;
const nav = [
  { href: '/', label: 'Assemblée', key: 'assemblee' },
  { href: '/agenda/', label: 'Agenda', key: 'agenda' },
  { href: '/scrutins/', label: 'Scrutins', key: 'scrutins' },
  { href: '/deputes/', label: 'Députés', key: 'deputes' },
  { href: '/lobbying/', label: 'Lobbying', key: 'lobbying' },
  { href: '/histoire/', label: 'Depuis 1958', key: 'histoire' },
  { href: '/methode/', label: 'Méthode', key: 'methode' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FBFBF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1216" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-head wrap">
      <a class="mark" href="/">Parlementeur</a>
      <nav aria-label="Principale">
        {nav.map((n) => <a href={n.href} aria-current={section === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <Search />
      <button class="theme" type="button" aria-label="Changer de thème" title="Clair ou sombre">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 2.5a7.5 7.5 0 0 1 0 15z" fill="currentColor"/></svg>
      </button>
    </header>
    <nav class="tabbar" aria-label="Navigation">
      <a href="/" aria-current={section === 'assemblee' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 18a9 9 0 0 1 18 0" fill="none" stroke="currentColor" stroke-width="2"/><path d="M7.5 18a4.5 4.5 0 0 1 9 0" fill="none" stroke="currentColor" stroke-width="2"/></svg>Assemblée</a>
      <a href="/agenda/" aria-current={section === 'agenda' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 10h16M9 3v4M15 3v4" stroke="currentColor" stroke-width="2"/></svg>Agenda</a>
      <a href="/scrutins/" aria-current={section === 'scrutins' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l4 4 10-10" fill="none" stroke="currentColor" stroke-width="2.2"/></svg>Scrutins</a>
      <a href="/deputes/" aria-current={section === 'deputes' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M5 20a7 7 0 0 1 14 0" fill="none" stroke="currentColor" stroke-width="2"/></svg>Députés</a>
      <details class="more">
        <summary aria-current={['lobbying', 'histoire', 'methode'].includes(section ?? '') ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.8" fill="currentColor"/><circle cx="12" cy="12" r="1.8" fill="currentColor"/><circle cx="19" cy="12" r="1.8" fill="currentColor"/></svg>Plus</summary>
        <div class="sheet">
          <a href="/lobbying/">Lobbying</a>
          <a href="/rencontres/">Qui a rencontré qui</a>
          <a href="/histoire/">L'hémicycle depuis 1958</a>
          <a href="/methode/">Méthode et sources</a>
          <a href="/coulisses/">Coulisses du pipeline</a>
        </div>
      </details>
    </nav>
    <main class="wrap">
      <slot />
    </main>
    <HoverCard />
    <footer class="site-foot wrap">
      <hr class="rule" />
      <div class="foot-grid">
        <p>
          Parlementeur est conçu et développé par <a href={SITE.authorUrl} rel="author">{SITE.author}</a>.
        </p>
        <p class="muted small">
          Données publiques officielles, chaque chiffre renvoie à sa source. Aucun cookie, aucun traceur, aucune mesure d'audience.
          Code et données <a href={SITE.repo}>ouverts</a>. <a href="/methode/">Méthode et sources</a> · <a href="/coulisses/">Coulisses du pipeline</a>.
        </p>
      </div>
    </footer>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        document.dispatchEvent(new CustomEvent('themechange'));
      });
    </script>
    <style>
      .site-head {
        display: flex; align-items: center; gap: 12px 24px; flex-wrap: wrap;
        padding-block: 16px; border-bottom: 1px solid var(--ink-16); margin-bottom: 32px;
      }
      .mark { font-family: var(--serif); font-weight: 600; font-size: 1.4rem; text-decoration: none; letter-spacing: -0.01em; }
      nav { display: flex; gap: 4px 18px; flex-wrap: wrap; flex: 1; font-size: 0.95rem; }
      nav a { text-decoration: none; color: var(--ink-62); padding-block: 4px; }
      nav a:hover, nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; }
      .theme { background: none; border: 1px solid var(--ink-16); border-radius: 50%; width: 36px; height: 36px; display: grid; place-items: center; }
      .site-foot { margin-top: 80px; padding-bottom: 40px; }
      .foot-grid { display: grid; gap: 8px; padding-top: 20px; }
      .tabbar { display: none; }
      @media (max-width: 760px) {
        .site-head { margin-bottom: 18px; padding-block: 10px; position: sticky; top: env(safe-area-inset-top, 0px); z-index: 25; background: var(--bg); }
        .site-head nav { display: none; }
        .site-head :global(.search) { margin-left: auto; }
        .tabbar {
          display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
          background: var(--bg); border-top: 1px solid var(--ink-16);
          padding: 6px 4px calc(6px + env(safe-area-inset-bottom, 0px));
        }
        .tabbar > a, .tabbar summary { display: grid; justify-items: center; gap: 2px; font-size: 0.68rem; text-decoration: none; color: var(--ink-62); list-style: none; cursor: pointer; padding: 2px 0; }
        .tabbar summary::-webkit-details-marker { display: none; }
        .tabbar svg { width: 22px; height: 22px; }
        .tabbar [aria-current='page'] { color: var(--ink); font-weight: 700; }
        .tabbar .sheet { position: absolute; right: 8px; bottom: calc(100% + 8px); background: var(--bg); border: 1px solid var(--ink-16); border-radius: 12px; padding: 6px; display: grid; min-width: 220px; box-shadow: 0 10px 30px color-mix(in srgb, var(--ink) 18%, transparent); }
        .tabbar .sheet a { padding: 10px 12px; text-decoration: none; border-radius: 8px; }
        .tabbar .sheet a:hover { background: var(--ink-4); }
        .site-foot { padding-bottom: calc(90px + env(safe-area-inset-bottom, 0px)); }
      }
    </style>
  </body>
</html>
