---
import Base from '../../layouts/Base.astro';
import HemicycleStatic from '../../components/HemicycleStatic.astro';
import { load, readOptional, fmtDate, fmtEur, fmtPct, fmtInt, type DeputeDetail, type Depute } from '../../lib/data';
import { strip, mapPoints } from '../../lib/charts';
import { plural, orgName } from '../../lib/text';
import { median } from '../../lib/stats';

export function getStaticPaths() {
  return load().deputes.map((d) => ({ params: { slug: d.slug } }));
}

const { deputes, groupes, meta } = load();
const d = deputes.find((x) => x.slug === Astro.params.slug)!;
const det = readOptional<DeputeDetail>(`deputes/${d.slug}.json`);
const g = groupes.find((x) => x.sigle === d.groupe);
const idx = deputes.indexOf(d);
const fills = deputes.map((x) => (x.groupe === d.groupe ? `color-mix(in srgb, ${g?.couleur ?? '#9A9A9A'} 45%, var(--bg))` : 'var(--ink-8)'));
fills[idx] = g?.couleur ?? 'var(--ink)';

const nom = `${d.prenom} ${d.nom}`;

// Profil : où se situe ce député parmi les 577, indicateur par indicateur.
const col = g?.couleur ?? 'var(--ink)';
const commRate = (x: Depute) => (x.commissions?.convocations ? x.commissions.presents / x.commissions.convocations : null);
const metrics: { label: string; get: (x: Depute) => number | null; fmt: (v: number) => string; ax: { min: number; max: number; log?: boolean }; more: string; less: string }[] = [
  { label: 'Présence aux scrutins', get: (x) => x.participation, fmt: fmtPct, ax: { min: 0, max: 0.8 }, more: 'vote plus souvent que', less: 'vote moins souvent que' },
  { label: 'Votes solennels', get: (x) => x.participationSolennels, fmt: fmtPct, ax: { min: 0.2, max: 1 }, more: 'participe plus aux grands votes que', less: 'participe moins aux grands votes que' },
  { label: 'Votes confiés à un collègue', get: (x) => x.partDelegation ?? null, fmt: fmtPct, ax: { min: 0, max: 1 }, more: 'fait voter à sa place plus souvent que', less: 'fait voter à sa place moins souvent que' },
  { label: 'Loyauté envers son groupe', get: (x) => x.loyaute, fmt: fmtPct, ax: { min: 0.6, max: 1 }, more: 'suit davantage son groupe que', less: "s'écarte davantage de son groupe que" },
  { label: 'Amendements déposés', get: (x) => x.amendements + 1, fmt: (v) => fmtInt(v - 1), ax: { min: 1, max: 3000, log: true }, more: "dépose plus d'amendements que", less: "dépose moins d'amendements que" },
  { label: 'Questions écrites', get: (x) => x.questions + 1, fmt: (v) => fmtInt(v - 1), ax: { min: 1, max: 120, log: true }, more: 'pose plus de questions que', less: 'pose moins de questions que' },
  { label: 'Prises de parole en séance', get: (x) => (x.interventions ?? 0) + 1, fmt: (v) => fmtInt(v - 1), ax: { min: 1, max: 5000, log: true }, more: 'prend plus souvent la parole que', less: 'prend moins souvent la parole que' },
  { label: 'Présence en commission', get: commRate, fmt: fmtPct, ax: { min: 0, max: 1 }, more: 'est plus présent en commission que', less: 'est moins présent en commission que' },
  { label: 'Âge', get: (x) => x.age, fmt: (v) => `${v} ans`, ax: { min: 25, max: 85 }, more: 'est plus âgé que', less: 'est plus jeune que' },
];
const profile = metrics
  .map((m) => {
    const me = m.get(d);
    if (me == null) return null;
    const all = deputes.map(m.get).filter((v): v is number => v != null);
    const below = all.filter((v) => v < me).length / all.length;
    const gmed = median(deputes.filter((x) => x.groupe === d.groupe).map(m.get).filter((v): v is number => v != null));
    const phrase = below >= 0.5 ? `${m.more} ${Math.round(below * 100)} % des députés` : `${m.less} ${Math.round((1 - below - all.filter((v) => v === me).length / all.length) * 100)} % des députés`;
    // Accord au féminin pour les députées.
    const accord = d.femme ? phrase.replace(/\bprésent\b/g, 'présente').replace(/\bâgé\b/g, 'âgée') : phrase;
    return { label: m.label, value: m.fmt(me), phrase: accord, svg: strip(all, me, m.ax, col, gmed ?? undefined).replace('role="img"', `role="img" aria-label="${m.label} : ${m.fmt(me)}, ${accord.replace(/"/g, '')}"`) };
  })
  .filter((p): p is NonNullable<typeof p> => p != null);
const VOTE_LBL: Record<string, string> = { pour: 'Pour', contre: 'Contre', abstention: 'Abstention', absent: 'Absent' };
const lastAmount = (m: { annee: number; montant: number }[]) => [...m].sort((a, b) => b.annee - a.annee)[0];
// Position sur la carte des votes (analyse des votes de tous les députés).
const prox = readOptional<{ carte: { points: Record<string, [number, number]>; variance: [number, number] } }>('proximite.json');
const gcolor = new Map(groupes.map((x) => [x.sigle, x.couleur]));
const bySlug = new Map(deputes.map((x) => [x.slug, x]));
const miniMap = prox?.carte.points[d.slug]
  ? mapPoints(
      Object.entries(prox.carte.points).map(([s, [x, y]]) => {
        const o = bySlug.get(s)!;
        return { x, y, s, n: `${o.prenom} ${o.nom}`, g: o.groupe, c: gcolor.get(o.groupe) ?? '#999' };
      }),
      { highlight: d.slug, dim: true },
    )
  : null;
const inter = det?.interets;
const totalPart = d.participationsTotal ?? 0;
const sections = [
  ['chiffres', 'Chiffres clés'],
  ['profil', 'Profil'],
  ['votes', 'Votes'],
  ['interets', 'Intérêts'],
  ...(det?.rencontres ? [['rencontres', 'Rencontres']] : []),
  ...(det?.elections?.length ? [['election', 'Élection']] : []),
  ['parcours', 'Parcours'],
  ['sources', 'Sources'],
];
const description = `${nom}, ${d.femme ? 'députée' : 'député'} ${g?.nom ?? d.groupe}${d.circonscription ? ', ' + d.circonscription : ''}. Présence aux votes, discipline de groupe, intérêts déclarés, parcours.`;
---
<Base title={nom} description={description} og={`/og/depute-${d.slug}.png`} section="deputes">
  <article class="fiche stack" style="--gap:40px">
    <header class="head">
      <div class="stack" style="--gap:10px">
        <p class="kicker"><span class="dot" style={`background:${g?.couleur}`}></span>{g?.nom ?? d.groupe}</p>
        <h1>{nom}</h1>
        <p class="lede">
          {d.femme ? 'Députée' : 'Député'}{d.circonscription ? ` de la ${d.circonscription}` : ''}{d.age != null ? `, ${d.age} ans` : ''}{d.profession ? `. ${d.profession}` : ''}.
        </p>
      </div>
      {d.photo && <img class="photo" src={d.photo} alt={`Portrait officiel de ${nom}`} width="120" height="150" loading="lazy" />}
    </header>
    <nav class="toc" aria-label="Sommaire de la fiche">
      {sections.map(([id, l]) => <a href={`#${id}`}>{l}</a>)}
      <a href={`/comparer/?a=${d.slug}`} class="cmp">Comparer ⇄</a>
    </nav>

    <section class="stack" style="--gap:14px" id="chiffres">
      <h2 class="sr-only">Chiffres clés</h2>
      <div class="kpis">
        <div><b class="num">{d.participation != null ? fmtPct(d.participation) : '–'}</b><span>des scrutins votés en personne</span></div>
        <div><b class="num">{d.loyaute != null ? fmtPct(d.loyaute) : '–'}</b><span>de votes alignés sur son groupe</span></div>
        <div><b class="num">{fmtInt(d.amendements)}</b><span>{plural(d.amendements, 'amendement déposé', 'amendements déposés')}, dont {fmtInt(d.amendementsAdoptes)} {plural(d.amendementsAdoptes, 'adopté', 'adoptés')}</span></div>
        <div><b class="num">{d.commissions?.convocations ? fmtPct(d.commissions.presents / d.commissions.convocations) : '–'}</b><span>de présence en commission</span></div>
        <div><b class="num">{fmtInt(d.interventions ?? 0)}</b><span>{plural(d.interventions ?? 0, 'prise de parole', 'prises de parole')} en séance</span></div>
        <div><b class="num">{fmtInt(d.questions)}</b><span>{plural(d.questions, 'question écrite', 'questions écrites')} au gouvernement</span></div>
      </div>
      <details class="more-kpis">
        <summary>6 autres indicateurs</summary>
        <div class="kpis">
          <div><b class="num">{d.participationSolennels != null ? fmtPct(d.participationSolennels) : '–'}</b><span>des votes solennels</span></div>
          <div><b class="num">{det?.dissidences != null ? fmtInt(det.dissidences) : '–'}</b><span>votes contre la ligne de son groupe</span></div>
          <div><b class="num">{d.partDelegation != null ? fmtPct(d.partDelegation) : '–'}</b><span>de ses votes confiés à un collègue (vote par délégation, en son absence)</span></div>
          <div><b class="num">{fmtInt(d.joursVote ?? 0)}</b><span>jours où {d.femme ? 'elle' : 'il'} a voté en séance</span></div>
          <div><b class="num">{d.legislatures ?? '–'}</b><span>{d.legislatures === 1 ? 'premier mandat' : 'législatures effectuées'}</span></div>
          <div><b class="num">{d.revenusAnnexes != null ? fmtEur(d.revenusAnnexes) : '–'}</b><span>de revenus annexes déclarés{d.anneeRevenus ? ` (${d.anneeRevenus})` : ''}</span></div>
        </div>
        <p class="small muted">Commissions : {fmtInt(d.commissions?.presents ?? 0)} réunions sur {fmtInt(d.commissions?.convocations ?? 0)}, soit {fmtInt(Math.round((d.commissions?.minutes ?? 0) / 60))} h. Prises de parole hors présidence de séance.</p>
      </details>
    </section>
    {d.fonction && <p class="muted">{d.fonction}{d.fonction.startsWith('Présidente') || d.fonction.startsWith('Président') ? " : préside les séances et ne prend pas part aux votes, d'où l'absence de taux de présence." : '.'}</p>}

    <section class="stack" style="--gap:14px" id="profil">
      <h2>Son profil parmi les {deputes.length} députés</h2>
      <p class="muted small">Chaque point gris est un député. Le grand point, c'est {nom} ; le trait, la médiane de son groupe ({d.groupe}).</p>
      <div class="profile">
        {profile.map((p) => (
          <div class="pr">
            <p><b>{p.label}</b> <span class="num">{p.value}</span></p>
            <Fragment set:html={p.svg} />
            <p class="small muted">{d.femme ? 'Elle' : 'Il'} {p.phrase}.</p>
          </div>
        ))}
      </div>
    </section>

    <section class="stack" style="--gap:12px" id="votes">
      {miniMap && (
        <div class="stack" style="--gap:8px">
          <h2>Avec qui vote-t-{d.femme ? 'elle' : 'il'} ?</h2>
          <p class="muted small">Chaque point est un député, placé selon ses votes : plus deux points sont proches, plus ces députés votent souvent de la même façon. {nom} est le point cerclé.</p>
          <figure class="minimap"><Fragment set:html={miniMap} /></figure>
          <p class="small"><a href="/qui-vote-avec-qui/">Explorer la carte des votes</a> · <a href={`/comparer/?a=${d.slug}`}>Comparer {d.femme ? 'cette députée' : 'ce député'} avec un autre</a></p>
        </div>
      )}
      <h2>Sa place dans l'hémicycle</h2>
      <HemicycleStatic fills={fills} slugs={deputes.map((x) => x.slug)} highlight={idx} label={`Position de ${nom} dans l'hémicycle`} />
      <p class="src">Source : <a href={d.urlAN}>fiche officielle de l'Assemblée nationale</a>.</p>
    </section>

    {det?.votesCles?.length ? (
      <section class="stack" style="--gap:12px">
        <h2>Ses votes sur les scrutins marquants</h2>
        <ul class="votes">
          {det.votesCles.slice(0, 10).map((v) => (
            <li>
              <span class={`vote v-${v.vote}`}>{VOTE_LBL[v.vote]}</span>
              <a href={`/scrutins/${v.numero}/`}>{v.titre}</a>
              <span class="muted small num">{fmtDate(v.date)}{v.ligneGroupe && v.vote !== 'absent' && v.ligneGroupe !== v.vote ? ' · contre la ligne de son groupe' : ''}</span>
            </li>
          ))}
        </ul>
        {det.votesCles.length > 10 && (
          <details>
            <summary>Voir les {det.votesCles.length - 10} autres votes marquants</summary>
        <ul class="votes more-votes">
          {det.votesCles.slice(10).map((v) => (
            <li>
              <span class={`vote v-${v.vote}`}>{VOTE_LBL[v.vote]}</span>
              <a href={`/scrutins/${v.numero}/`}>{v.titre}</a>
              <span class="muted small num">{fmtDate(v.date)}{v.ligneGroupe && v.vote !== 'absent' && v.ligneGroupe !== v.vote ? ' · contre la ligne de son groupe' : ''}</span>
            </li>
          ))}
        </ul>
          </details>
        )}
      </section>
    ) : null}

    <section class="stack" style="--gap:12px" id="interets">
      <h2>Intérêts et activités déclarés</h2>
      {inter ? (
        <div class="stack" style="--gap:16px">
          <ul class="facts">
            <li><b class="num">{fmtInt(d.participationsN ?? 0)}</b> {plural(d.participationsN ?? 0, 'participation financière déclarée', 'participations financières déclarées')}{totalPart > 0 ? <>, pour une valeur totale déclarée de <b class="num">{fmtEur(totalPart)}</b></> : ''}</li>
            <li><b class="num">{fmtInt(d.directions ?? 0)}</b> {plural(d.directions ?? 0, 'fonction de direction conservée', 'fonctions de direction conservées')} pendant le mandat (entreprise, association, organisme)</li>
            {d.delaiDeclaration != null && <li>Déclaration déposée <b class="num">{fmtInt(d.delaiDeclaration)} jours</b> après son entrée en fonctions{d.delaiDeclaration > 61 ? ' (délai légal : deux mois)' : ', dans le délai légal de deux mois'}{inter.modifications ? `, puis modifiée ${inter.modifications} fois` : ''}</li>}
          </ul>
          <p class="muted small">Dernière déclaration d'intérêts et d'activités déposée auprès de la HATVP le {fmtDate(inter.date)}. <a href="/interets/">Comparer avec les autres députés</a>.</p>
          {det.interets.activites.length > 0 && (
            <table class="tbl">
              <caption class="sr-only">Activités professionnelles déclarées</caption>
              <thead><tr><th>Activité déclarée</th><th class="r">Dernier montant</th></tr></thead>
              <tbody>
                {det.interets.activites.map((a) => { const m = lastAmount(a.montants); return (
                  <tr><td>{a.description}{a.employeur ? <span class="muted"> · {a.employeur}</span> : null}</td><td class="r num">{m ? `${fmtEur(m.montant)} (${m.annee})` : '–'}</td></tr>
                ); })}
              </tbody>
            </table>
          )}
          {det.interets.participations.length > 0 && (
            <table class="tbl">
              <caption class="sr-only">Participations financières déclarées</caption>
              <thead><tr><th>Participation au capital d'une société</th><th class="r">Évaluation déclarée</th></tr></thead>
              <tbody>
                {det.interets.participations.map((p) => (
                  <tr><td>{orgName(p.societe)}{p.parts ? <span class="muted"> · {p.parts}</span> : null}{p.lobby && <span class="lobline"><span class="lob">lobby</span> <a href={p.lobby.fiche}>{orgName(p.lobby.nom)}</a> a déclaré {p.lobby.actions} {plural(p.lobby.actions, 'action', 'actions')} auprès des parlementaires{p.lobby.domaines.length ? ` (${p.lobby.domaines.slice(0, 2).join(', ').toLowerCase()})` : ''}</span>}</td><td class="r num">{p.evaluation != null ? fmtEur(p.evaluation) : '–'}</td></tr>
                ))}
              </tbody>
            </table>
          )}
          <p class="src">Source : <a href={det.interets.url}>déclaration publiée par la HATVP</a>. Le patrimoine des députés n'est consultable qu'en préfecture et sa publication est interdite (loi du 11 octobre 2013, article 26) : <a href="/methode/#patrimoine">pourquoi il n'apparaît pas ici</a>.</p>
        </div>
      ) : (
        <p class="muted">Aucune déclaration d'intérêts publiée par la HATVP n'a été rapprochée de ce député.</p>
      )}
    </section>

    {det?.elections?.length ? (
      <section class="stack" style="--gap:12px" id="election">
        <h2>Son élection</h2>
        {det.elections.map((e) => (
          <p>
            Élu{d.femme ? 'e' : ''} en {e.annee} au {e.tour === 1 ? 'premier' : 'second'} tour avec <b class="num">{e.pct?.toLocaleString('fr-FR')} %</b> des suffrages exprimés ({fmtInt(e.voix)} voix, étiquette {e.nuance}), pour une participation de {e.participation?.toLocaleString('fr-FR')} %.
            {e.adversaires.length > 0 && <> Face à : {e.adversaires.map((a) => `${a.nom} (${a.nuance}, ${a.pct?.toLocaleString('fr-FR')} %)`).join(', ')}.</>}
          </p>
        ))}
        <p class="src">Source : <a href={det.elections[0].source}>ministère de l'Intérieur, résultats définitifs</a>. Les étiquettes (nuances) sont attribuées par le ministère.</p>
      </section>
    ) : null}

    {det?.presidentielles?.length ? (
      <section class="stack" style="--gap:12px">
        <h2>Candidatures à l'élection présidentielle</h2>
        <ul class="plain">
          {det.presidentielles.map((p) => (
            <li><b>{p.annee}</b> : {p.tour1 != null ? `${p.tour1.toLocaleString('fr-FR')} % au premier tour` : 'candidature'}{p.tour2 != null ? `, ${p.tour2.toLocaleString('fr-FR')} % au second tour` : ''}{p.elu ? ' (élu)' : ''}. <a class="small" href={p.source}>source</a></li>
          ))}
        </ul>
      </section>
    ) : null}

    {det?.rencontres && (
      <section class="stack" style="--gap:14px" id="rencontres">
        <h2>Rencontres documentées</h2>
        <p class="muted small">Ce que les documents publics disent des organisations que {d.femme ? 'cette députée' : 'ce député'} a entendues. <a href="/rencontres/#methode">D'où viennent ces données</a>.</p>
        {det.rencontres.rapporteur.length > 0 && (
          <div class="stack" style="--gap:6px">
            <h3 class="h4">Comme rapporteur{d.femme ? 'e' : ''} : {det.rencontres.rapporteur.length} auditions listées dans ses rapports</h3>
            <ul class="plain small">
              {det.rencontres.rapporteur.slice(0, 25).map((o) => (
                <li>{(o.registre.length > 0 || o.etoile) && <span class="lob" title="Organisation inscrite au répertoire des représentants d'intérêts">lobby</span>} {o.organisation.slice(0, 160)}{o.registre.length > 0 && <span class="muted"> · répertoire HATVP : {o.registre.join(', ')}</span>} <a href={o.rapports[0].url}>rapport</a></li>
              ))}
            </ul>
            {det.rencontres.rapporteur.length > 25 && <p class="small muted">Et {det.rencontres.rapporteur.length - 25} autres, dans les annexes des rapports.</p>}
          </div>
        )}
        <div class="stack" style="--gap:6px">
          <h3 class="h4">En commission : présent{d.femme ? 'e' : ''} à {det.rencontres.commissions.total} auditions{det.rencontres.commissions.avecLobby.length ? `, dont ${det.rencontres.commissions.avecLobby.length} avec une organisation inscrite comme lobby` : ''}</h3>
          {det.rencontres.commissions.avecLobby.length > 0 && (
            <ul class="plain small">
              {det.rencontres.commissions.avecLobby.slice(0, 12).map((a) => <li><span class="lob">lobby</span> {fmtDate(a.date)} · {a.registre.join(', ')} <span class="muted">({a.organe})</span></li>)}
            </ul>
          )}
        </div>
        {det.rencontres.amendementsTotal > 0 && (
          <div class="stack" style="--gap:6px">
            <h3 class="h4">{det.rencontres.amendementsTotal} amendements au texte identique à ceux d'autres groupes</h3>
            <ul class="plain small">
              {det.rencontres.amendements.slice(0, 6).map((a) => <li>« {a.texte.slice(0, 140)}… » <span class="muted">déposé par {a.n} députés de {a.groupes} groupes</span> <a href={`https://www.assemblee-nationale.fr/dyn/17/amendements/${a.exemple}`}>voir</a></li>)}
            </ul>
          </div>
        )}
      </section>
    )}

    <section class="stack" style="--gap:12px" id="parcours">
      <h2>Condamnations définitives</h2>
      {det?.condamnations?.length ? (
        <ul class="plain">
          {det.condamnations.map((c) => (
            <li class="stack" style="--gap:4px">
              <p><b>{c.faits}</b></p>
              <p>{c.juridiction}, {fmtDate(c.date)}. Peine : {c.peine}.</p>
              <p class="muted small">{c.definitive_depuis ? `Définitive depuis le ${fmtDate(c.definitive_depuis)}. ` : ''}{c.precision} Source : <a href={c.source.url}>{c.source.label}</a>.</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">Aucune condamnation définitive recensée selon <a href="/methode/#condamnations">notre règle</a> : seules sont publiées les condamnations pénales définitives, confirmées par une source, et non effacées par la réhabilitation légale.</p>
      )}
    </section>

    {det && (det.mandats.length > 0 || det.groupesHistorique.length > 1) && (
      <section class="stack" style="--gap:12px">
        <h2>Parcours</h2>
        <ul class="plain">
          {det.mandats.map((m) => <li><b>{m.legislature}<sup>e</sup> législature</b> · {fmtDate(m.debut)} – {m.fin ? fmtDate(m.fin) : "aujourd'hui"}{m.circonscription ? ` · ${m.circonscription}` : ''}</li>)}
        </ul>
        {det.groupesHistorique.length > 1 && (
          <p>Groupes successifs : {det.groupesHistorique.map((h) => `${h.nom} (${h.sigle}) depuis le ${fmtDate(h.debut)}`).join(' ; ')}.</p>
        )}
      </section>
    )}

    <section class="stack" style="--gap:8px" id="sources">
      <h2>Sources</h2>
      <ul class="plain src">
        <li><a href={d.urlAN}>Fiche du député, Assemblée nationale</a></li>
        {d.urlHATVP && <li><a href={d.urlHATVP}>Déclarations publiées, HATVP</a></li>}
        {det?.sources?.map((s) => <li><a href={s.url}>{s.label}</a>{s.date ? `, consulté le ${fmtDate(s.date)}` : ''}</li>)}
        <li>Données extraites le {fmtDate(meta.generatedAt)}.</li>
      </ul>
    </section>
  </article>
</Base>

<style>
