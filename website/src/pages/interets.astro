---
import Base from '../layouts/Base.astro';
import { load, readOptional, fmtInt, fmtEur } from '../lib/data';
import { swarm } from '../lib/charts';
import { median } from '../lib/stats';
import { plural, orgName } from '../lib/text';

type Soc = { nom: string; deputes: string[]; total: number; lobby: { nom: string; actions: number; domaines: string[]; objets: string[]; fiche: string } | null };
const I = readOptional<{ societes: Soc[]; delaiLegal: number; source: string; sourceLobby: string }>('interets.json')!;
const { deputes, groupes } = load();
const bySlug = new Map(deputes.map((d) => [d.slug, d]));
const gcol = new Map(groupes.map((g) => [g.sigle, g.couleur]));
const who = (s: string) => bySlug.get(s);
const declared = deputes.filter((d) => d.participationsN != null);
const holders = declared.filter((d) => (d.participationsTotal ?? 0) > 0);
const lobbySoc = I.societes.filter((s) => s.lobby).sort((a, b) => b.lobby!.actions - a.lobby!.actions);
const topSoc = I.societes.filter((s) => s.deputes.length >= 3).slice(0, 15);
const maxSoc = topSoc[0]?.deputes.length ?? 1;

// Essaim par groupe, groupes classés par médiane décroissante.
const rowsFor = (list: typeof deputes, val: (d: (typeof deputes)[number]) => number | null | undefined, label: (v: number) => string) =>
  groupes
    .map((g) => ({ label: g.sigle, color: g.couleur, points: list.filter((d) => d.groupe === g.sigle && val(d) != null).map((d) => ({ v: val(d)!, s: d.slug, n: `${d.prenom} ${d.nom}`, g: d.groupe, label: label(val(d)!) })) }))
    .filter((r) => r.points.length)
    .sort((a, b) => (median(b.points.map((p) => p.v)) ?? 0) - (median(a.points.map((p) => p.v)) ?? 0));

const kEur = (v: number) => (v >= 1e6 ? `${v / 1e6} M€` : v >= 1000 ? `${v / 1000} k€` : `${v} €`);
const partSvg = swarm(rowsFor(holders, (d) => d.participationsTotal, fmtEur), { min: 100, max: 3e7, ticks: [100, 1e4, 1e6], fmt: kEur, log: true });
const medHold = median(holders.map((d) => d.participationsTotal!)) ?? 0;

const withDelay = deputes.filter((d) => d.delaiDeclaration != null);
const late = withDelay.filter((d) => d.delaiDeclaration! > I.delaiLegal);
const delaySvg = swarm(rowsFor(withDelay, (d) => Math.min(d.delaiDeclaration!, 200), (v) => `${v} jours`), { min: 0, max: 200, ticks: [0, 30, 60, 90, 120, 150, 200], fmt: (v) => (v === 200 ? '200+' : String(v)) }, [{ v: I.delaiLegal, label: 'délai légal' }]);

const dirByGroup = groupes
  .map((g) => {
    const m = declared.filter((d) => d.groupe === g.sigle);
    const k = m.filter((d) => (d.directions ?? 0) > 0);
    return { g, n: m.length, k: k.length, share: m.length ? k.length / m.length : 0 };
  })
  .filter((x) => x.n >= 3)
  .sort((a, b) => b.share - a.share);
const topDir = [...declared].filter((d) => (d.directions ?? 0) > 0).sort((a, b) => b.directions! - a.directions!).slice(0, 10);
const names = (slugs: string[]) => slugs.map(who).filter(Boolean);
---
<Base title="Intérêts déclarés des députés" description="Participations financières, sociétés détenues, fonctions de direction, délais de déclaration : ce que les députés déclarent à la HATVP, et quand ces sociétés font aussi du lobbying." section="interets">
  <div class="stack" style="--gap:48px">
    <header class="stack" style="--gap:12px">
      <p class="kicker">Intérêts déclarés · HATVP</p>
      <h1>Ce que les députés détiennent et dirigent</h1>
      <p class="lede">Chaque député déclare ses activités, ses participations dans des sociétés et ses fonctions de direction. Ces déclarations sont publiques. Voici ce qu'elles montrent, mises bout à bout.</p>
      <p class="note">Le patrimoine des députés (immobilier, épargne…) n'apparaît pas ici : sa publication est interdite par la loi. <a href="/methode/#patrimoine">Pourquoi</a>.</p>
    </header>

    <section class="kpis">
      <div><b class="num">{fmtInt(declared.length)}</b><span>déclarations d'intérêts rapprochées sur {deputes.length} députés</span></div>
      <div><b class="num">{fmtInt(holders.length)}</b><span>députés déclarent des parts dans au moins une société</span></div>
      <div><b class="num">{fmtInt(I.societes.length)}</b><span>sociétés identifiables détenues</span></div>
      <div><b class="num">{fmtInt(lobbySoc.length)}</b><span>d'entre elles font aussi du lobbying auprès des parlementaires</span></div>
    </section>

    <section class="stack" style="--gap:14px" id="participations">
      <h2>Combien valent leurs participations ?</h2>
      <p class="muted">Valeur totale des parts de sociétés déclarées par chaque député, telle qu'il l'a lui-même évaluée. Échelle logarithmique : chaque graduation multiplie par cent. Valeur médiane : <b class="num">{fmtEur(medHold)}</b>. Les {fmtInt(declared.length - holders.length)} députés sans participation déclarée ne sont pas représentés.</p>
      <figure class="fig"><Fragment set:html={partSvg.replace('role="img"', 'role="img" aria-label="Valeur des participations déclarées, par groupe"')} /><p class="pick small" aria-live="polite">Touchez un point pour voir le député.</p></figure>
    </section>

    <section class="stack" style="--gap:14px" id="societes">
      <h2>Les sociétés les plus détenues</h2>
      <p class="muted">Nombre de députés qui déclarent des parts dans la même société. Touchez une ligne pour voir qui.</p>
      <div class="bars">
        {topSoc.map((s) => (
          <details class="row">
            <summary>
              <span class="lbl">{s.nom}{s.lobby && <span class="lob" title="Inscrite au répertoire des représentants d'intérêts">lobby</span>}</span>
              <span class="track"><span class="fill" style={`width:${(s.deputes.length / maxSoc) * 100}%`}></span></span>
              <span class="v num">{s.deputes.length}</span>
            </summary>
            <ul class="names">{names(s.deputes).map((d) => <li><i class="dot" style={`background:${gcol.get(d!.groupe)}`}></i><a href={`/deputes/${d!.slug}/`}>{d!.prenom} {d!.nom}</a> <span class="muted">{d!.groupe}</span></li>)}</ul>
          </details>
        ))}
      </div>
    </section>

    <section class="stack" style="--gap:14px" id="lobby">
      <h2>Quand la société détenue fait du lobbying</h2>
      <p class="muted">Ces {lobbySoc.length} sociétés sont détenues en partie par au moins un député, et ont déclaré à la HATVP des actions d'influence visant des parlementaires depuis juillet 2024. Détenir des actions n'est ni interdit ni suspect en soi : c'est une information que la loi rend publique, pour que chacun puisse juger.</p>
      <ul class="cards">
        {lobbySoc.map((s, i) => (
          <li class="card" hidden={i >= 8}>
            <p class="cn">{s.nom}</p>
            <p class="small"><b class="num">{s.lobby!.actions}</b> {plural(s.lobby!.actions, 'action de lobbying déclarée', 'actions de lobbying déclarées')} auprès des parlementaires{s.lobby!.domaines.length ? <>, sur : {s.lobby!.domaines.join(', ').toLowerCase()}</> : ''}.</p>
            <p class="small">Détenue par {names(s.deputes).map((d, j) => <>{j > 0 && ', '}<a href={`/deputes/${d!.slug}/#interets`}>{d!.prenom} {d!.nom}</a> <span class="muted">({d!.groupe})</span></>)}.</p>
            <p class="small"><a href={s.lobby!.fiche}>Fiche de {orgName(s.lobby!.nom)} au répertoire</a></p>
          </li>
        ))}
      </ul>
      {lobbySoc.length > 8 && <button type="button" class="showall" data-target="#lobby .cards">Voir les {lobbySoc.length - 8} autres sociétés</button>}
    </section>

    <section class="stack" style="--gap:14px" id="directions">
      <h2>Qui dirige quoi en plus du mandat ?</h2>
      <p class="muted">Part des députés de chaque groupe qui déclarent au moins une fonction de direction conservée pendant le mandat : entreprise, association, fondation, organisme public local.</p>
      <div class="bars">
        {dirByGroup.map((x) => (
          <div class="row static">
            <span class="lbl"><i class="dot" style={`background:${x.g.couleur}`}></i>{x.g.sigle}</span>
            <span class="track"><span class="fill" style={`width:${x.share * 100}%;background:${x.g.couleur}`}></span></span>
            <span class="v num">{x.k}/{x.n}</span>
          </div>
        ))}
      </div>
      <details class="longlist"><summary>Les dix députés qui déclarent le plus de fonctions</summary>
        <ol class="ranked">{topDir.map((d) => <li><a href={`/deputes/${d.slug}/#interets`}>{d.prenom} {d.nom}</a> <span class="muted">{d.groupe}</span> <b class="num">{d.directions}</b></li>)}</ol>
      </details>
    </section>

    <section class="stack" style="--gap:14px" id="delais">
      <h2>Déclarer à temps</h2>
      <p class="muted">Un député doit déposer sa déclaration d'intérêts dans les deux mois qui suivent son entrée en fonctions. Nombre de jours entre l'entrée en fonctions et le dépôt enregistré par la HATVP : <b>{fmtInt(withDelay.length - late.length)}</b> députés dans le délai, <b>{fmtInt(late.length)}</b> au-delà.</p>
      <figure class="fig"><Fragment set:html={delaySvg.replace('role="img"', 'role="img" aria-label="Délai de dépôt de la déclaration d\'intérêts, par groupe"')} /><p class="pick small" aria-live="polite">Touchez un point pour voir le député.</p></figure>
    </section>

    <section class="stack" style="--gap:10px">
      <h2 class="h3">D'où viennent ces données</h2>
      <p class="muted">Déclarations d'intérêts et d'activités publiées en open data par la HATVP, rapprochées de chaque député par nom et date de naissance. Les valeurs sont celles déclarées par les députés eux-mêmes. Les noms de sociétés civiles (SCI, GFA…) sont masqués par la HATVP : elles comptent dans les totaux mais pas dans le classement des sociétés. Une société détenue est reliée au répertoire des représentants d'intérêts quand son nom y figure à l'identique (hors forme juridique).</p>
      <p class="src">Sources : <a href={I.source}>HATVP, déclarations d'intérêts et d'activités</a> · <a href={I.sourceLobby}>HATVP, répertoire des représentants d'intérêts</a> · <a href="https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000035586109">code électoral, article LO 135-1 (II)</a>.</p>
    </section>
  </div>
</Base>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('.fig')) {
    const svg = fig.querySelector<SVGSVGElement>('svg')!;
    const out = fig.querySelector<HTMLElement>('.pick')!;
    const pts = [...svg.querySelectorAll<SVGCircleElement>('[data-s]')];
    let sel: Element | null = null;
    svg.addEventListener('click', (e) => {
      let best: SVGCircleElement | null = null, bd = Infinity;
      for (const c of pts) {
        const r = c.getBoundingClientRect();
        const d = (r.x + r.width / 2 - e.clientX) ** 2 + (r.y + r.height / 2 - e.clientY) ** 2;
        if (d < bd) { bd = d; best = c; }
      }
      if (!best || bd > 22 * 22) return;
      sel?.classList.remove('on');
      sel = best;
      best.classList.add('on');
      const d = best.dataset;
      out.innerHTML = '';
      const a = document.createElement('a');
      a.href = `/deputes/${d.s}/#interets`;
      a.textContent = d.n!;
      out.append(a, ` · ${d.g} · ${d.v}`);
    });
  }
</script>

<style>
  .note { font-size: 0.92rem; color: var(--ink-62); border-left: 2px solid var(--ink-16); padding-left: 12px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 16px; }
  .kpis div { border-top: 2px solid var(--ink); padding-top: 8px; display: grid; }
  .kpis b { font-family: var(--serif); font-size: 2rem; font-weight: 600; line-height: 1.1; }
  .kpis span { font-size: 0.85rem; color: var(--ink-62); }
  .fig { margin: 0; display: grid; gap: 6px; max-width: 720px; }
  .fig :global(svg) { width: 100%; height: auto; display: block; overflow: visible; }
  .fig :global(.tk) { font-size: 11px; fill: var(--ink-62); font-family: var(--sans); }
  .fig :global(.rl) { font-size: 11.5px; fill: var(--ink); font-weight: 600; font-family: var(--sans); }
  .fig :global(.rt) { font-size: 10.5px; fill: var(--ink-62); font-family: var(--sans); }
  .fig :global(.grid) { stroke: var(--ink-8); }
  .fig :global(.base) { stroke: var(--ink-16); }
  .fig :global(.ref) { stroke: var(--ink-62); stroke-dasharray: 3 3; }
  .fig :global(.med) { stroke: var(--ink); stroke-width: 2; }
  .fig :global([data-s]) { cursor: pointer; }
  .fig :global(.on) { stroke: var(--ink); stroke-width: 2; }
  .pick { min-height: 1.5em; }
  .pick :global(a) { font-weight: 600; }
  .bars { display: grid; gap: 2px; max-width: 720px; }
  .row summary, .row.static { display: grid; grid-template-columns: minmax(110px, 40%) 1fr 48px; gap: 10px; align-items: center; font-size: 0.92rem; padding: 9px 0; list-style: none; }
  .row summary { cursor: pointer; }
  .row summary::-webkit-details-marker { display: none; }
  .row summary .lbl::after { content: ' ▸'; color: var(--ink-62); font-size: 0.75em; }
  .row[open] summary .lbl::after { content: ' ▾'; }
  .lbl { display: inline-flex; align-items: center; gap: 6px; min-width: 0; flex-wrap: wrap; }
  .track { height: 12px; background: var(--ink-8); border-radius: 2px; overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--ramp-to); }
  .v { text-align: right; }
  .names { list-style: none; margin: 4px 0 10px; padding: 8px 12px; background: var(--ink-4); border-radius: 6px; columns: 2 200px; font-size: 0.88rem; }
  .names li { break-inside: avoid; padding: 3px 0; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; flex: none; }
  .lob { display: inline-block; font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 6px; border-radius: 999px; border: 1.5px solid var(--ramp-to); color: var(--ink); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .card { border: 1px solid var(--ink-16); border-radius: 10px; padding: 14px; display: grid; gap: 6px; align-content: start; }
  .cn { font-family: var(--serif); font-size: 1.25rem; font-weight: 600; }
  .longlist summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .ranked { margin: 0; padding-left: 1.4em; display: grid; gap: 6px; }
  .ranked b { float: right; }
  .h3 { font-size: var(--step-2); }
</style>
