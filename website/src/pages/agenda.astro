---
import Base from '../layouts/Base.astro';
import { load } from '../lib/data';

const { deputes } = load();
// Correspondance slug → nom et groupe, pour le classement du temps de travail.
const who = Object.fromEntries(deputes.map((d) => [d.slug, [`${d.prenom} ${d.nom}`, d.groupe]]));
---
<Base title="L'agenda de l'Assemblée" description="Chaque séance publique, chaque réunion de commission et chaque vote, jour par jour : combien d'heures l'Assemblée siège, et qui est présent." og="/og/vue-participation.png" section="agenda">
  <div class="stack" style="--gap:28px">
    <header class="stack" style="--gap:10px">
      <p class="kicker">Assemblée nationale · agenda officiel</p>
      <h1>L'agenda de l'Assemblée</h1>
      <p class="lede">Séances publiques dans l'hémicycle, réunions de commission et votes, jour par jour. Choisissez une période : les chiffres se recalculent.</p>
    </header>

    <div class="toolbar">
      <div class="nav">
        <button type="button" data-nav="-1" aria-label="Période précédente">‹</button>
        <button type="button" data-nav="0">Aujourd'hui</button>
        <button type="button" data-nav="1" aria-label="Période suivante">›</button>
        <h2 id="label" aria-live="polite">…</h2>
      </div>
      <div class="seg" role="group" aria-label="Affichage">
        <button type="button" data-mode="mois" aria-pressed="true">Mois</button>
        <button type="button" data-mode="semaine" aria-pressed="false">Semaine</button>
        <button type="button" data-mode="annee" aria-pressed="false">Année</button>
      </div>
    </div>

    <div class="kpis" id="kpis"></div>

    <div class="legend small">
      <span><i class="k-seance"></i>Séance publique</span>
      <span><i class="k-com"></i>Réunion de commission</span>
      <span><i class="k-vote"></i>Scrutins publics</span>
      <span><i class="k-futur"></i>À venir ou prévisionnel</span>
    </div>

    <div id="cal" class="cal" aria-live="polite"><p class="muted">Chargement de l'agenda…</p></div>

    <aside id="detail" class="detail" hidden>
      <button type="button" class="close" aria-label="Fermer">×</button>
      <div class="detail-body"></div>
    </aside>

    <section class="stack" style="--gap:14px" id="travail">
      <h2>Le temps de travail des députés</h2>
      <p class="muted">Heures par semaine : sur la période affichée (arrondie aux mois entiers), heures de présence en commission et durée réelle des séances publiques où le député a voté ou siégé, divisées par le nombre de semaines où l'Assemblée a siégé depuis son élection. Une semaine de séance sans aucune trace de sa présence compte zéro.</p>
      <p class="muted small">Limites : l'Assemblée n'enregistre pas nominativement la présence en séance. Voter une fois pendant une séance compte pour toute la séance, et un député présent qui ne vote pas n'est pas compté. Le travail en circonscription, en réunion de groupe ou en audition hors commission n'apparaît dans aucune donnée publique.</p>
      <div class="scroll">
        <table class="tbl" id="ttable">
          <thead>
            <tr>
              <th data-k="0">Député</th>
              <th data-k="5" class="r">Heures par semaine</th>
              <th data-k="2" class="r">Heures en commission</th>
              <th data-k="3" class="r">Présence en commission</th>
              <th data-k="4" class="r">Jours de vote</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <button type="button" id="more" class="more">Voir tous les députés</button>
    </section>

    <p class="src">Sources : <a href="https://data.assemblee-nationale.fr/reunions/reunions">Assemblée nationale, agenda des réunions</a>, <a href="https://data.assemblee-nationale.fr/travaux-parlementaires/debats">comptes rendus des séances</a> et scrutins publics. Les séances publiques sont placées à leurs heures réelles d'ouverture et de levée, lues dans le compte rendu officiel ; les réunions de commission, à leurs horaires annoncés.</p>
  </div>
  <script type="application/json" id="who" set:html={JSON.stringify(who)}></script>
</Base>

<script>
  type Ev = { t: 'seance' | 'commission' | 'autre'; d: string; m: number | null; o: string; x: string; v: number; p: number | null; c: number | null; e: string | null; ro?: string; rm?: number; rs?: number };
  type Travail = { mois: string[]; semaines: Record<string, string[]>; debut: Record<string, string>; deputes: Record<string, number[][]> };

  const MOIS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
  const JOURS = ['lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.', 'dim.'];
  const who: Record<string, [string, string]> = JSON.parse(document.getElementById('who')!.textContent!);
  const cal = document.getElementById('cal')!;
  const label = document.getElementById('label')!;
  const kpis = document.getElementById('kpis')!;
  const detail = document.getElementById('detail')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const pad = (n: number) => String(n).padStart(2, '0');
  const key = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const hm = (d: Date) => (d.getHours() === 0 && d.getMinutes() === 0 ? 'journée' : `${d.getHours()}h${d.getMinutes() ? pad(d.getMinutes()) : ''}`);
  const hours = (min: number) => (min / 60).toLocaleString('fr-FR', { maximumFractionDigits: 0 });
  const mondayOf = (d: Date) => { const x = new Date(d); x.setHours(0, 0, 0, 0); x.setDate(x.getDate() - ((x.getDay() + 6) % 7)); return x; };
  const addDays = (d: Date, n: number) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };

  let events: (Ev & { start: Date; end: Date; planned: Date })[] = [];
  let byDay = new Map<string, (Ev & { start: Date; end: Date; planned: Date })[]>();
  let travail: Travail | null = null;
  const today = new Date();
  let mode: 'mois' | 'semaine' | 'annee' = 'mois';
  let cursor = new Date(today);
  let showAll = false;
  const small = () => window.matchMedia('(max-width: 700px)').matches;
  let selectedDay = key(today);
  let sortKey = 5;
  let sortDir = -1;

  // Période couverte par l'affichage courant.
  function range(): [Date, Date] {
    if (mode === 'semaine') { const s = mondayOf(cursor); return [s, addDays(s, 7)]; }
    if (mode === 'annee') return [new Date(cursor.getFullYear(), 0, 1), new Date(cursor.getFullYear() + 1, 0, 1)];
    return [new Date(cursor.getFullYear(), cursor.getMonth(), 1), new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1)];
  }

  function renderKpis(a: Date, b: Date) {
    const sel = events.filter((e) => e.start >= a && e.start < b);
    const seances = sel.filter((e) => e.t === 'seance');
    const coms = sel.filter((e) => e.t === 'commission');
    // Heures effectives : durée réelle moins les suspensions, sinon horaire annoncé.
    const minS = seances.reduce((s, e) => s + (e.rm != null ? e.rm - (e.rs ?? 0) : e.m ?? 0), 0);
    const reelles = seances.filter((e) => e.rm != null).length;
    const minC = coms.reduce((s, e) => s + (e.m ?? 0), 0);
    const votes = seances.reduce((s, e) => s + e.v, 0);
    const jours = new Set(seances.map((e) => key(e.start))).size;
    const joursVote = new Set(seances.filter((e) => e.v > 0).map((e) => key(e.start))).size;
    const k = (v: string, l: string) => `<div><b class="num">${v}</b><span>${l}</span></div>`;
    kpis.innerHTML =
      k(String(jours), `jour${jours > 1 ? 's' : ''} de séance publique`) +
      k(`${hours(minS)} h`, reelles === seances.length ? `de séance effective (${seances.length} séances, suspensions déduites)` : `en séance (${seances.length} séances, dont ${reelles} aux heures réelles)`) +
      k(`${hours(minC)} h`, `de réunions de commission (${coms.length})`) +
      k(votes.toLocaleString('fr-FR'), `scrutins publics, sur ${joursVote} jour${joursVote > 1 ? 's' : ''}`);
  }

  function chip(e: Ev & { start: Date }, compact = false) {
    const futur = e.start > today || e.e ? ' futur' : '';
    const cls = e.t === 'seance' ? 'c-seance' : 'c-com';
    const vote = e.v ? ` <span class="vb">${e.v} vote${e.v > 1 ? 's' : ''}</span>` : '';
    const lbl = e.t === 'seance' ? 'Séance' : esc((e.o || 'Réunion').replace(/^Commission (des |de la |de l'|du )?/i, '').slice(0, compact ? 22 : 60));
    return `<button type="button" class="chip ${cls}${futur}" data-i="${events.indexOf(e as never)}">${hm(e.start)} ${lbl}${vote}</button>`;
  }

  function dayList(k: string) {
    const evs = (byDay.get(k) ?? []).slice().sort((a, b) => Number(b.t === 'seance') - Number(a.t === 'seance') || +a.start - +b.start);
    const [y, m, d] = k.split('-').map(Number);
    const title = `${JOURS[(new Date(y, m - 1, d).getDay() + 6) % 7]} ${d} ${MOIS[m - 1]}`;
    if (!evs.length) return `<div class="dl"><h3>${title}</h3><p class="muted small">Aucune séance ni réunion.</p></div>`;
    return `<div class="dl"><h3>${title}</h3>${evs.map((e) => chip(e)).join('')}</div>`;
  }

  // Mobile : grille compacte à pastilles, et liste des réunions du jour touché.
  function renderMonthSmall() {
    const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
    const start = mondayOf(first);
    if (!selectedDay.startsWith(key(first).slice(0, 7))) {
      const firstActive = [...byDay.keys()].sort().find((k) => k.startsWith(key(first).slice(0, 7)) && byDay.get(k)!.some((e) => e.t === 'seance'));
      selectedDay = firstActive ?? key(first);
    }
    let html = '<div class="mgrid">' + JOURS.map((j) => `<div class="dow">${j[0].toUpperCase()}</div>`).join('');
    for (let i = 0; i < 42; i++) {
      const d = addDays(start, i);
      if (i >= 35 && d.getMonth() !== cursor.getMonth()) break;
      const evs = byDay.get(key(d)) ?? [];
      const ns = evs.filter((e) => e.t === 'seance').length;
      const nc = evs.length - ns;
      const vote = evs.some((e) => e.v > 0);
      const out = d.getMonth() !== cursor.getMonth() ? ' out' : '';
      const sel = key(d) === selectedDay ? ' sel' : '';
      const isToday = key(d) === key(today) ? ' today' : '';
      html += `<button type="button" class="mc${out}${sel}${isToday}" data-pick="${key(d)}"><span>${d.getDate()}</span><i class="pips">${'<b class="ps"></b>'.repeat(Math.min(ns, 3))}${nc ? '<b class="pc"></b>' : ''}</i>${vote ? '<em class="pv"></em>' : ''}</button>`;
    }
    cal.innerHTML = html + '</div>' + dayList(selectedDay);
    label.textContent = `${MOIS[cursor.getMonth()].replace(/^./, (c) => c.toUpperCase())} ${cursor.getFullYear()}`;
  }

  // Mobile : planning de la semaine, jour par jour.
  function renderWeekSmall() {
    const start = mondayOf(cursor);
    let html = '';
    for (let i = 0; i < 7; i++) {
      const k = key(addDays(start, i));
      if ((byDay.get(k) ?? []).length) html += dayList(k);
    }
    cal.innerHTML = html || '<p class="muted">Aucune séance ni réunion cette semaine.</p>';
    const end = addDays(start, 6);
    label.textContent = `Semaine du ${start.getDate()} ${MOIS[start.getMonth()]} au ${end.getDate()} ${MOIS[end.getMonth()]}`;
  }

  function renderMonth() {
    const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
    const start = mondayOf(first);
    let html = '<div class="month">' + JOURS.map((j) => `<div class="dow">${j}</div>`).join('');
    for (let i = 0; i < 42; i++) {
      const d = addDays(start, i);
      if (i >= 35 && d.getMonth() !== cursor.getMonth()) break;
      const evs = byDay.get(key(d)) ?? [];
      const seances = evs.filter((e) => e.t === 'seance');
      const coms = evs.filter((e) => e.t !== 'seance');
      const out = d.getMonth() !== cursor.getMonth() ? ' out' : '';
      const isToday = key(d) === key(today) ? ' today' : '';
      html += `<div class="day${out}${isToday}"><button type="button" class="dnum" data-day="${key(d)}">${d.getDate()}</button>` +
        seances.map((e) => chip(e, true)).join('') +
        (coms.length ? `<button type="button" class="more-com" data-day="${key(d)}">${coms.length} réunion${coms.length > 1 ? 's' : ''} de commission</button>` : '') +
        '</div>';
    }
    cal.innerHTML = html + '</div>';
    label.textContent = `${MOIS[cursor.getMonth()].replace(/^./, (c) => c.toUpperCase())} ${cursor.getFullYear()}`;
  }

  function renderWeek() {
    const start = mondayOf(cursor);
    const H0 = 8, H1 = 25;
    const pxh = 44;
    let cols = '';
    for (let i = 0; i < 7; i++) {
      const d = addDays(start, i);
      const evs = (byDay.get(key(d)) ?? []).slice().sort((a, b) => +a.start - +b.start);
      // Les séances publiques ont leur propre bande à gauche ; les commissions se partagent le reste.
      const seances = evs.filter((e) => e.t === 'seance');
      const others = evs.filter((e) => e.t !== 'seance');
      const zoneS = seances.length ? (others.length ? 0.42 : 1) : 0;
      const layout = (list: typeof evs, x0: number, w: number) => {
        const lanes: Date[] = [];
        const placed = list.map((e) => {
          let l = lanes.findIndex((end) => end <= e.start);
          if (l < 0) { l = lanes.length; lanes.push(e.end); } else lanes[l] = e.end;
          return { e, l };
        });
        const n = Math.max(1, lanes.length);
        return placed.map(({ e, l }) => ({ e, left: x0 + (l / n) * w, width: w / n }));
      };
      const blocks = [...layout(seances, 0, zoneS), ...layout(others, zoneS, 1 - zoneS)].map(({ e, left, width }) => {
        const sh = e.start.getHours() + e.start.getMinutes() / 60;
        const noTime = sh === 0;
        const top = noTime ? 0 : Math.max(0, (sh - H0) * pxh);
        const dur = (e.end.getTime() - e.start.getTime()) / 3600000;
        const h = noTime ? 20 : Math.max(18, Math.min(H1 - Math.max(sh, H0), dur) * pxh);
        const futur = e.start > today || e.e ? ' futur' : '';
        const cls = e.t === 'seance' ? 'c-seance' : 'c-com';
        const time = noTime ? 'horaire non précisé' : hm(e.start);
        return `<button type="button" class="blk ${cls}${futur}" data-i="${events.indexOf(e)}" title="${esc(`${time} · ${e.t === 'seance' ? 'Séance publique' : e.o}`)}" style="top:${top}px;height:${h}px;left:${left * 100}%;width:${width * 100}%"><b>${time}</b> ${esc(e.t === 'seance' ? 'Séance publique' : e.o)}${e.v ? `<span class="vb">${e.v} votes</span>` : ''}</button>`;
      }).join('');
      const isToday = key(d) === key(today) ? ' today' : '';
      cols += `<div class="wcol"><div class="whead${isToday}">${JOURS[i]} ${d.getDate()}</div><div class="wbody" style="height:${(H1 - H0) * pxh}px">${blocks}</div></div>`;
    }
    const hoursCol = Array.from({ length: H1 - H0 }, (_, i) => `<div style="height:${pxh}px">${(H0 + i) % 24}h</div>`).join('');
    cal.innerHTML = `<div class="week"><div class="whours"><div class="whead"></div>${hoursCol}</div>${cols}</div>`;
    const end = addDays(start, 6);
    label.textContent = `Semaine du ${start.getDate()} ${MOIS[start.getMonth()]} au ${end.getDate()} ${MOIS[end.getMonth()]} ${end.getFullYear()}`;
  }

  function renderYear() {
    const y = cursor.getFullYear();
    let html = '<div class="year">';
    for (let m = 0; m < 12; m++) {
      const first = new Date(y, m, 1);
      const start = mondayOf(first);
      let cells = '';
      for (let i = 0; i < 42; i++) {
        const d = addDays(start, i);
        if (d.getMonth() !== m) { cells += '<span class="yc empty"></span>'; continue; }
        const evs = byDay.get(key(d)) ?? [];
        const min = evs.reduce((s, e) => s + (e.t === 'seance' ? e.m ?? 0 : 0), 0);
        const vote = evs.some((e) => e.v > 0);
        const t = Math.min(1, min / 720);
        cells += `<button type="button" class="yc${vote ? ' voted' : ''}" data-day="${key(d)}" title="${d.getDate()} ${MOIS[m]} : ${hours(min)} h de séance${vote ? ', avec votes' : ''}" style="background:${min ? `color-mix(in srgb, var(--ramp-to) ${Math.round(20 + t * 80)}%, var(--ramp-from))` : 'var(--ink-4)'}"></button>`;
      }
      html += `<div class="ym"><button type="button" class="ymt" data-month="${m}">${MOIS[m]}</button><div class="ygrid">${cells}</div></div>`;
    }
    cal.innerHTML = html + '</div><p class="small muted">Intensité : heures de séance publique dans la journée. Contour : jour avec au moins un scrutin public.</p>';
    label.textContent = String(y);
  }

  function renderTravail(a: Date, b: Date) {
    if (!travail) return;
    const from = `${a.getFullYear()}-${pad(a.getMonth() + 1)}`;
    const last = new Date(b.getTime() - 1);
    const to = `${last.getFullYear()}-${pad(last.getMonth() + 1)}`;
    const idx = travail.mois.map((m, i) => (m >= from && m <= to ? i : -1)).filter((i) => i >= 0);
    // Pour chaque député : semaines de séance de la période postérieures à son élection.
    const rows = Object.entries(travail.deputes).map(([slug, arr]) => {
      const deb = travail!.debut[slug] ?? '0000-00-00';
      let conv = 0, pres = 0, minC = 0, jours = 0, minS = 0;
      const weeks = new Set<string>();
      for (const i of idx) {
        const m = travail!.mois[i];
        if (m < deb.slice(0, 7)) continue;
        conv += arr[i][0]; pres += arr[i][1]; minC += arr[i][2]; jours += arr[i][3]; minS += arr[i][4] ?? 0;
        for (const w of travail!.semaines[m] ?? []) weeks.add(w);
      }
      const hebdo = weeks.size >= 2 ? (minC + minS) / 60 / weeks.size : -1;
      return [slug, conv, minC, conv ? pres / conv : -1, jours, hebdo, minS, weeks.size] as [string, number, number, number, number, number, number, number];
    });
    rows.sort((x, y) => (sortKey === 0 ? who[x[0]][0].localeCompare(who[y[0]][0], 'fr') * -sortDir : (x[sortKey] - y[sortKey]) * sortDir));
    const shown = showAll ? rows : rows.slice(0, 20);
    const h1 = (n: number) => n.toLocaleString('fr-FR', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
    document.querySelector('#ttable tbody')!.innerHTML = shown
      .map(([slug, conv, minC, rate, jours, hebdo, minS, nw]) => `<tr><td><a href="/deputes/${slug}/">${esc(who[slug][0])}</a> <span class="muted small">${esc(who[slug][1])}</span></td><td class="r num"><b>${hebdo < 0 ? '–' : h1(hebdo) + ' h'}</b><span class="muted small sub">${hebdo < 0 ? 'trop récent' : `séance ${hours(minS)} h · commission ${hours(minC)} h · ${nw} sem.`}</span></td><td class="r num">${hours(minC)} h</td><td class="r num">${rate < 0 ? '–' : Math.round(rate * 100) + ' %'} <span class="muted small">(${conv})</span></td><td class="r num">${jours}</td></tr>`)
      .join('');
    document.getElementById('more')!.textContent = showAll ? 'Réduire' : `Voir les ${rows.length} députés`;
    document.querySelectorAll<HTMLElement>('#ttable th').forEach((th) => th.setAttribute('aria-sort', Number(th.dataset.k) === sortKey ? (sortDir > 0 ? 'ascending' : 'descending') : 'none'));
  }

  function render() {
    detail.hidden = true;
    if (mode === 'mois') (small() ? renderMonthSmall : renderMonth)(); else if (mode === 'semaine') (small() ? renderWeekSmall : renderWeek)(); else renderYear();
    const [a, b] = range();
    renderKpis(a, b);
    renderTravail(a, b);
    document.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.mode === mode)));
  }

  function openEvent(i: number) {
    const e = events[i];
    const dh = (m: number) => `${Math.floor(m / 60)} h ${pad(m % 60)}`;
    const dur = e.rm != null
      ? `réel : ${dh(e.rm)}${e.rs ? `, dont ${e.rs} min de suspension` : ''} (prévu à ${hm(e.planned)})`
      : e.m ? `prévu : ${dh(e.m)}` : 'durée non publiée';
    const pres = e.c ? `<p>${e.p} députés présents sur ${e.c} convoqués.</p>` : '';
    const votes = e.v ? `<p><a href="/scrutins/?date=${key(e.start)}">${e.v} scrutin${e.v > 1 ? 's' : ''} public${e.v > 1 ? 's' : ''} ce jour-là →</a></p>` : '';
    detail.querySelector('.detail-body')!.innerHTML = `<p class="kicker">${e.t === 'seance' ? 'Séance publique' : 'Réunion'}${e.start > today || e.e ? ' · à venir' : ''}</p><h3>${esc(e.o || 'Réunion')}</h3><p class="muted">${JOURS[(e.start.getDay() + 6) % 7]} ${e.start.getDate()} ${MOIS[e.start.getMonth()]} ${e.start.getFullYear()}, ${hm(e.start)} · ${dur}</p>${e.x ? `<p>${esc(e.x)}</p>` : ''}${pres}${votes}`;
    detail.hidden = false;
    detail.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  cal.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const btn = t.closest<HTMLElement>('[data-i],[data-day],[data-month],[data-pick]');
    if (!btn) return;
    if (btn.dataset.pick) { selectedDay = btn.dataset.pick; renderMonthSmall(); return; }
    if (btn.dataset.i) openEvent(Number(btn.dataset.i));
    else if (btn.dataset.day) { const [y, m, d] = btn.dataset.day.split('-').map(Number); cursor = new Date(y, m - 1, d); mode = 'semaine'; render(); }
    else if (btn.dataset.month) { cursor = new Date(cursor.getFullYear(), Number(btn.dataset.month), 1); mode = 'mois'; render(); }
  });
  detail.querySelector('.close')!.addEventListener('click', () => (detail.hidden = true));
  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => { mode = b.dataset.mode as typeof mode; render(); }));
  document.querySelectorAll<HTMLButtonElement>('[data-nav]').forEach((b) =>
    b.addEventListener('click', () => {
      const n = Number(b.dataset.nav);
      if (n === 0) cursor = new Date(today);
      else if (mode === 'semaine') cursor = addDays(cursor, 7 * n);
      else if (mode === 'annee') cursor = new Date(cursor.getFullYear() + n, 0, 1);
      else cursor = new Date(cursor.getFullYear(), cursor.getMonth() + n, 1);
      render();
    }),
  );
  document.querySelectorAll<HTMLElement>('#ttable th').forEach((th) =>
    th.addEventListener('click', () => {
      const k = Number(th.dataset.k);
      sortDir = sortKey === k ? -sortDir : k === 0 ? 1 : -1;
      sortKey = k;
      render();
    }),
  );
  document.getElementById('more')!.addEventListener('click', () => { showAll = !showAll; render(); });

  Promise.all([fetch('/agenda.json').then((r) => r.json()), fetch('/travail.json').then((r) => r.json())]).then(([ev, tr]: [Ev[], Travail]) => {
    events = ev.map((e) => {
      const planned = new Date(e.d);
      // Quand le compte rendu existe, on place la séance à ses heures réelles.
      if (e.ro && e.rm != null) {
        const [h, mi] = e.ro.split(':').map(Number);
        const start = new Date(planned);
        start.setHours(h, mi, 0, 0);
        return { ...e, planned, start, end: new Date(start.getTime() + e.rm * 60000) };
      }
      return { ...e, planned, start: planned, end: new Date(planned.getTime() + (e.m ?? 120) * 60000) };
    });
    byDay = new Map();
    for (const e of events) {
      const k = key(e.start);
      if (!byDay.has(k)) byDay.set(k, []);
      byDay.get(k)!.push(e);
    }
    travail = tr;
    // Sans séance ce mois-ci (vacances parlementaires), on ouvre sur le dernier mois actif.
    const monthKey = key(today).slice(0, 7);
    if (!events.some((e) => e.t === 'seance' && e.d.startsWith(monthKey))) {
      const lastPast = [...events].reverse().find((e) => e.t === 'seance' && e.start <= today);
      if (lastPast) cursor = new Date(lastPast.start);
    }
    render();
  });
</script>

