---
import { layoutHemicycle } from '../lib/hemicycle';
import { VIEWS, viewById } from '../lib/views';
import type { Depute, Groupe } from '../lib/data';
import { fmtPct, fmtEur, readOptional } from '../lib/data';

interface Props {
  deputes: Depute[];
  groupes: Groupe[];
  view: string;
}
const { deputes, groupes, view } = Astro.props;
const v = viewById(view);
const L = layoutHemicycle(deputes.length);
const gcolor = new Map(groupes.map((g) => [g.sigle, g.couleur]));

function fill(viewId: string, d: Depute): string {
  const vw = viewById(viewId);
  if (vw.kind === 'groupe') return gcolor.get(d.groupe) ?? '#9A9A9A';
  const x = vw.value!(d);
  if (x == null) return 'var(--ink-8)';
  if (vw.kind === 'binaire') return x ? 'var(--ramp-to)' : 'var(--ink-62)';
  const t = Math.round((x as number) * 100);
  return `color-mix(in srgb, var(--ramp-to) ${t}%, var(--ramp-from))`;
}

const initial = deputes.map((d) => fill(v.id, d));
// Valeur montrée dans la micro-fiche au survol, selon la thématique affichée.
function hoverValue(d: Depute): string | undefined {
  switch (v.id) {
    case 'age': return d.age != null ? `${d.age} ans` : undefined;
    case 'participation': return d.participation != null ? `Vote à ${fmtPct(d.participation)} des scrutins` : undefined;
    case 'solennels': return d.participationSolennels != null ? `${fmtPct(d.participationSolennels)} des votes solennels` : undefined;
    case 'loyaute': return d.loyaute != null ? `Loyauté : ${fmtPct(d.loyaute)}` : undefined;
    case 'amendements': return `${d.amendements} amendements déposés`;
    case 'anciennete': return d.legislatures != null ? `${d.legislatures} législature${d.legislatures > 1 ? 's' : ''}` : undefined;
    case 'revenus': return d.revenusAnnexes != null ? `Revenus annexes : ${fmtEur(d.revenusAnnexes)}` : undefined;
    case 'participations': return d.participationsTotal != null ? `Participations : ${fmtEur(d.participationsTotal)}` : undefined;
    default: return undefined;
  }
}
const people = deputes.map((d) => ({
  s: d.slug,
  n: `${d.prenom} ${d.nom}`,
  g: d.groupe,
  c: d.circonscription,
  a: d.age,
  f: d.femme,
  p: d.participation == null ? null : fmtPct(d.participation),
  l: d.loyaute == null ? null : fmtPct(d.loyaute),
  m: d.legislatures,
  r: d.revenusAnnexes == null ? null : fmtEur(d.revenusAnnexes),
  am: d.amendements,
  ph: d.photo,
}));
const groupNames = Object.fromEntries(groupes.map((g) => [g.sigle, g.nom]));

// Plan réel : position de chaque siège d'après le plan publié par l'Assemblée, ramenée dans le même cadre.
const plan = readOptional<{ source: string; sieges: Record<string, [number, number]> }>('sieges.json');
let real: [number, number][] | null = null;
let realDot = L.dot;
if (plan) {
  const pts = Object.values(plan.sieges);
  const minX = Math.min(...pts.map((p) => p[0])), maxX = Math.max(...pts.map((p) => p[0]));
  const minY = Math.min(...pts.map((p) => p[1])), maxY = Math.max(...pts.map((p) => p[1]));
  const pad = L.dot * 2;
  const k = Math.min((L.width - 2 * pad) / (maxX - minX), (L.height - 2 * pad) / (maxY - minY));
  const ox = (L.width - (maxX - minX) * k) / 2, oy = (L.height - (maxY - minY) * k) / 2;
  const pos = deputes.map((d) => (d.place && plan.sieges[String(Number(d.place))]) || null);
  if (pos.every(Boolean)) {
    real = pos.map((p, i) => [+(ox + (p![0] - minX) * k - L.seats[i].x).toFixed(1), +(oy + (p![1] - minY) * k - L.seats[i].y).toFixed(1)]);
    // Rayon : un peu moins de la moitié de la distance au plus proche voisin, sur un échantillon.
    const abs = pos.map((p) => [ox + (p![0] - minX) * k, oy + (p![1] - minY) * k]);
    let dmin = Infinity;
    for (let i = 0; i < abs.length; i += 7) for (let j = 0; j < abs.length; j++) if (i !== j) dmin = Math.min(dmin, Math.hypot(abs[i][0] - abs[j][0], abs[i][1] - abs[j][1]));
    realDot = Math.min(L.dot, dmin * 0.46);
  }
}
---
<section class="hemi-block" data-view={v.id}>


  <div class="hemi-grid">
    <figure class="hemi-fig">
      {real && (
        <div class="layout-toggle" role="group" aria-label="Disposition des sièges">
          <button type="button" data-layout="arcs" aria-pressed="true" aria-label="Par groupe" data-tip="Par groupe">
            <svg viewBox="0 0 24 14" width="24" height="14" aria-hidden="true"><path d="M2 13a10 10 0 0 1 5-8.66L9.5 8.7A5 5 0 0 0 7 13z" fill="currentColor"/><path d="M8 3.8a10 10 0 0 1 8 0L13.5 8.2a5 5 0 0 0-3 0z" fill="currentColor" opacity=".55"/><path d="M17 4.34A10 10 0 0 1 22 13h-5a5 5 0 0 0-2.5-4.3z" fill="currentColor"/></svg>
          </button>
          <button type="button" data-layout="reel" aria-pressed="false" aria-label="Plan réel" data-tip="Plan réel">
            <svg viewBox="0 0 24 14" width="24" height="14" aria-hidden="true">{[[3,12],[7,12],[17,12],[21,12],[4,8],[8,8],[16,8],[20,8],[6,4],[10,3],[14,3],[18,4]].map(([x,y]) => <circle cx={x} cy={y} r="1.5" fill="currentColor"/>)}</svg>
          </button>
        </div>
      )}
      <svg class="hemi" viewBox={`0 0 ${L.width.toFixed(0)} ${L.height.toFixed(0)}`} role="application" tabindex="0" aria-roledescription="hémicycle" aria-label={`Hémicycle de ${deputes.length} sièges : ${v.titre}. Flèches gauche et droite pour parcourir les sièges, Entrée pour ouvrir la fiche.`}>
        {L.seats.map((s, i) => (
          <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={L.dot.toFixed(2)} data-i={i} data-s={deputes[i].slug} data-v={hoverValue(deputes[i])} style={`fill:${initial[i]}`} />
        ))}
        <text x={L.cx} y={L.cy - 18} text-anchor="middle" class="hemi-total">{deputes.length}</text>
        <text x={L.cx} y={L.cy + 6} text-anchor="middle" class="hemi-sub">députés</text>
      </svg>
      <figcaption class="legend">
        {v.kind === 'groupe' && (
          <ul class="glegend">
            {groupes.map((g) => (
              <li title={g.nom}><i style={`background:${g.couleur}`}></i>{g.sigle} <span class="num muted">{g.effectif}</span></li>
            ))}
          </ul>
        )}
        {v.kind === 'rampe' && (
          <div class="rlegend">
            <div class="ramp"></div>
            <div class="rl"><span>{v.legende?.[0]}</span><span>{v.legende?.[1]}</span></div>
          </div>
        )}
        {v.kind === 'binaire' && (
          <ul class="glegend">
            <li><i style="background:var(--ink-62)"></i>{v.legende?.[0]}</li>
            <li><i style="background:var(--ramp-to)"></i>{v.legende?.[1]}</li>
          </ul>
        )}
      </figcaption>
      <p class="sr-live sr-only" aria-live="polite"></p>
      <p class="hint small muted">Touchez un siège pour ouvrir la fiche du député. <a href="/deputes/">Liste complète des {deputes.length} députés</a></p>
    </figure>

    <aside class="panel" hidden aria-live="polite">
      <button class="close" type="button" aria-label="Fermer la fiche">×</button>
      <div class="panel-body"></div>
    </aside>
  </div>

  <div class="views" role="toolbar" aria-label="Thématique">
    <div class="seg">
      {VIEWS.map((vw) => (
        <a href={vw.id === 'groupes' ? '/' : `/vue/${vw.id}/`} data-view={vw.id} aria-current={vw.id === v.id ? 'page' : undefined}>{vw.label}</a>
      ))}
    </div>
  </div>



  <script type="application/json" class="hemi-data" set:html={JSON.stringify({ real, realDot: +realDot.toFixed(2), dot: +L.dot.toFixed(2), people, groupNames })}></script>
</section>

<script>
  type Person = { s: string; n: string; g: string; c: string | null; a: number | null; f: boolean; p: string | null; l: string | null; m: number | null; r: string | null; am: number; ph: string | null };

  for (const block of document.querySelectorAll<HTMLElement>('.hemi-block')) {
    const data = JSON.parse(block.querySelector('.hemi-data')!.textContent!) as {
      real: [number, number][] | null; realDot: number; dot: number; people: Person[]; groupNames: Record<string, string>;
    };
    const circles = [...block.querySelectorAll<SVGCircleElement>('svg.hemi circle')];
    const panel = block.querySelector<HTMLElement>('.panel')!;
    const body = panel.querySelector<HTMLElement>('.panel-body')!;
    const baseUrl = location.pathname;
    let selected: SVGCircleElement | null = null;

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function open(i: number, push = true) {
      const p = data.people[i];
      selected?.classList.remove('sel');
      selected = circles[i];
      selected.classList.add('sel');
      const rows: [string, string | null][] = [
        ['Groupe', data.groupNames[p.g] ?? p.g],
        ['Circonscription', p.c],
        ['Âge', p.a == null ? null : `${p.a} ans`],
        ['Présence aux votes', p.p],
        ['Vote avec son groupe', p.l],
        ['Législatures', p.m == null ? null : String(p.m)],
        ['Amendements déposés', String(p.am)],
        ['Revenus annexes déclarés', p.r],
      ];
      body.innerHTML = `
        <p class="kicker">${esc(p.g)}</p>
        <h3>${esc(p.n)}</h3>
        <dl>${rows.filter(([, v]) => v).map(([k, v]) => `<dt>${k}</dt><dd>${esc(v!)}</dd>`).join('')}</dl>
        <a class="more" href="/deputes/${p.s}/">Fiche complète et sources →</a>`;
      panel.hidden = false;
      if (push) history.pushState({ seat: i }, '', `/deputes/${p.s}/`);
    }
    function close(push = true) {
      panel.hidden = true;
      selected?.classList.remove('sel');
      selected = null;
      if (push) history.pushState({}, '', baseUrl);
    }
    const svgEl = block.querySelector<SVGSVGElement>('svg.hemi')!;
    // Sur mobile, la thématique active est ramenée dans la zone visible de la barre.
    const bar = block.querySelector<HTMLElement>('.views')!;
    const cur = bar.querySelector<HTMLElement>('[aria-current="page"]');
    if (cur) bar.scrollLeft = cur.offsetLeft - (bar.clientWidth - cur.offsetWidth) / 2;
    // Indique qu'il reste des thématiques à faire défiler, à gauche ou à droite.
    const edges = () => {
      bar.classList.toggle('more-left', bar.scrollLeft > 4);
      bar.classList.toggle('more-right', bar.scrollLeft + bar.clientWidth < bar.scrollWidth - 4);
    };
    bar.addEventListener('scroll', edges, { passive: true });
    addEventListener('resize', edges);
    edges();
    block.querySelectorAll<HTMLButtonElement>('.layout-toggle button').forEach((btn) =>
      btn.addEventListener('click', () => {
        const reel = btn.dataset.layout === 'reel';
        block.querySelectorAll('.layout-toggle button').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
        svgEl.classList.toggle('reel', reel);
        circles.forEach((c, i) => {
          const d = data.real![i];
          c.style.transform = reel ? `translate(${d[0]}px, ${d[1]}px)` : '';
          c.setAttribute('r', String(reel ? data.realDot : data.dot));
        });
      }),
    );
    // Au doigt, un siège fait quelques pixels : on ouvre le siège le plus proche du point touché.
    const centre = (i: number) => {
      const c = circles[i];
      const t = svgEl.classList.contains('reel') && data.real ? data.real[i] : [0, 0];
      return [Number(c.getAttribute('cx')) + t[0], Number(c.getAttribute('cy')) + t[1]];
    };
    svgEl.addEventListener('click', (e) => {
      const m = svgEl.getScreenCTM();
      if (!m) return;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      let best = -1, dist = Infinity;
      circles.forEach((_, i) => {
        const [x, y] = centre(i);
        const d = (x - p.x) ** 2 + (y - p.y) ** 2;
        if (d < dist) { dist = d; best = i; }
      });
      // Tolérance : environ 22 pixels à l'écran autour du point touché.
      const tol = 22 / m.a;
      if (best >= 0 && dist <= tol * tol) open(best);
    });
    // Clavier : flèches pour parcourir les sièges, Entrée pour ouvrir la fiche complète.
    const live = block.querySelector<HTMLElement>('.sr-live')!;
    let cursor = -1;
    svgEl.addEventListener('keydown', (e) => {
      if (['ArrowRight', 'ArrowLeft', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key)) {
        e.preventDefault();
        const step = e.key === 'ArrowUp' || e.key === 'ArrowDown' ? 10 : 1;
        cursor = e.key === 'Home' ? 0 : e.key === 'End' ? circles.length - 1 : Math.max(0, Math.min(circles.length - 1, cursor + (e.key === 'ArrowLeft' || e.key === 'ArrowDown' ? -step : step)));
        open(cursor, false);
        const p = data.people[cursor];
        live.textContent = `${p.n}, ${data.groupNames[p.g] ?? p.g}${p.c ? ', ' + p.c : ''}`;
      } else if (e.key === 'Enter' && cursor >= 0) {
        location.href = `/deputes/${data.people[cursor].s}/`;
      }
    });
    panel.querySelector('.close')!.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) close(); });
    window.addEventListener('popstate', (e) => {
      if (e.state?.seat != null) open(e.state.seat, false);
      else close(false);
    });
  }
</script>

<style>
  .hemi-block { display: grid; gap: 16px; }
  .views { view-transition-name: views; overflow-x: auto; display: flex; justify-content: safe center; position: sticky; top: 0; z-index: 15; background: var(--bg); padding-block: 8px; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  .views .seg { flex-wrap: nowrap; white-space: nowrap; }
  .views::-webkit-scrollbar { display: none; }
  .views.more-right { mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent); -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 40px), transparent); }
  .views.more-left { mask-image: linear-gradient(90deg, transparent, #000 40px); -webkit-mask-image: linear-gradient(90deg, transparent, #000 40px); }
  .views.more-left.more-right { mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent); }
  .views .seg a { padding: 10px 14px; }
  .hint { text-align: center; }
  .hemi:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; border-radius: 8px; }
  @media (max-width: 760px) { .views { top: 56px; } }
  .hemi-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); }
  .hemi-fig { margin: 0; display: grid; gap: 12px; justify-items: center; }
  .hemi-fig .legend { justify-self: stretch; max-width: 900px; margin-inline: auto; width: 100%; }
  .hemi { view-transition-name: hemi; width: 100%; max-width: 900px; margin-inline: auto; height: auto; display: block; touch-action: manipulation; }
  .hemi circle { cursor: pointer; transition: fill 0.35s ease, transform 0.7s cubic-bezier(.4,0,.2,1); }
  .hemi.reel .hemi-total, .hemi.reel .hemi-sub { opacity: 0; }
  .hemi-total, .hemi-sub { transition: opacity .3s; }
  .hemi-fig { position: relative; }
  .layout-toggle { position: absolute; top: 0; right: 0; z-index: 2; display: flex; border: 1px solid var(--ink-16); border-radius: 8px; overflow: visible; background: var(--bg); }
  .layout-toggle button { position: relative; background: none; border: 0; padding: 12px 11px; min-width: 44px; color: var(--ink-62); display: grid; place-items: center; }
  .layout-toggle button + button { border-left: 1px solid var(--ink-16); }
  .layout-toggle button[aria-pressed='true'] { background: var(--ink); color: var(--bg); }
  .layout-toggle button:first-child { border-radius: 7px 0 0 7px; }
  .layout-toggle button:last-child { border-radius: 0 7px 7px 0; }
  .layout-toggle button::after { content: attr(data-tip); position: absolute; top: calc(100% + 6px); right: 0; white-space: nowrap; font-size: 0.78rem; background: var(--ink); color: var(--bg); padding: 3px 8px; border-radius: 4px; opacity: 0; pointer-events: none; transition: opacity 0.15s; }
  .layout-toggle button:hover::after, .layout-toggle button:focus-visible::after { opacity: 1; }
  .hemi circle:hover { stroke: var(--ink); stroke-width: 2; }
  .hemi :global(circle.sel) { stroke: var(--ink); stroke-width: 3; }
  .hemi-total { font-family: var(--serif); font-weight: 600; font-size: 52px; fill: var(--ink); }
  .hemi-sub { font-size: 15px; fill: var(--ink-62); }
  .glegend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.85rem; }
  .glegend li { display: inline-flex; align-items: center; gap: 6px; }
  .glegend i { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .rlegend { display: grid; gap: 4px; max-width: 420px; }
  .ramp { height: 10px; border-radius: 2px; background: linear-gradient(90deg, var(--ramp-from), var(--ramp-to)); }
  .rl { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--ink-62); }

  .panel {
    position: fixed; z-index: 20; background: var(--bg); border: 1px solid var(--ink-16);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--ink) 18%, transparent);
    left: 0; right: 0; bottom: 0; border-radius: 14px 14px 0 0; max-height: 72vh; overflow: auto;
    padding: 20px 20px calc(20px + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 900px) {
    .hemi-grid { grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; }
    .panel { position: sticky; top: 16px; inset: auto; align-self: start; border-radius: 8px; box-shadow: none; max-height: none; }
    .hemi-grid:has(.panel[hidden]) { grid-template-columns: minmax(0, 1fr); }
  }
  .close { position: absolute; top: 8px; right: 10px; background: none; border: 0; font-size: 1.6rem; line-height: 1; padding: 6px 10px; color: var(--ink-62); }
  .panel :global(h3) { font-size: 1.5rem; margin-block: 4px 12px; padding-right: 32px; }
  .panel :global(dl) { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0 0 16px; font-size: 0.92rem; }
  .panel :global(dt) { color: var(--ink-62); }
  .panel :global(dd) { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
  .panel :global(.more) { font-weight: 600; }
</style>
