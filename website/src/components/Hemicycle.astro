---
import { layoutHemicycle } from '../lib/hemicycle';
import { VIEWS, viewById } from '../lib/views';
import type { Depute, Groupe } from '../lib/data';
import { fmtPct, fmtEur, readOptional } from '../lib/data';

interface Props {
  deputes: Depute[];
  groupes: Groupe[];
  view: string;
}
const { deputes, groupes, view } = Astro.props;
const v = viewById(view);
const L = layoutHemicycle(deputes.length);
const gcolor = new Map(groupes.map((g) => [g.sigle, g.couleur]));

function fill(viewId: string, d: Depute): string {
  const vw = viewById(viewId);
  if (vw.kind === 'groupe') return gcolor.get(d.groupe) ?? '#9A9A9A';
  const x = vw.value!(d);
  if (x == null) return 'var(--ink-8)';
  if (vw.kind === 'binaire') return x ? 'var(--ramp-to)' : 'var(--ink-62)';
  const t = Math.round((x as number) * 100);
  return `color-mix(in srgb, var(--ramp-to) ${t}%, var(--ramp-from))`;
}

const initial = deputes.map((d) => fill(v.id, d));
const people = deputes.map((d) => ({
  s: d.slug,
  n: `${d.prenom} ${d.nom}`,
  g: d.groupe,
  c: d.circonscription,
  a: d.age,
  f: d.femme,
  p: d.participation == null ? null : fmtPct(d.participation),
  l: d.loyaute == null ? null : fmtPct(d.loyaute),
  m: d.legislatures,
  r: d.revenusAnnexes == null ? null : fmtEur(d.revenusAnnexes),
  am: d.amendements,
  ph: d.photo,
}));
const groupNames = Object.fromEntries(groupes.map((g) => [g.sigle, g.nom]));

// Plan réel : position de chaque siège d'après le plan publié par l'Assemblée, ramenée dans le même cadre.
const plan = readOptional<{ source: string; sieges: Record<string, [number, number]> }>('sieges.json');
let real: [number, number][] | null = null;
let realDot = L.dot;
if (plan) {
  const pts = Object.values(plan.sieges);
  const minX = Math.min(...pts.map((p) => p[0])), maxX = Math.max(...pts.map((p) => p[0]));
  const minY = Math.min(...pts.map((p) => p[1])), maxY = Math.max(...pts.map((p) => p[1]));
  const pad = L.dot * 2;
  const k = Math.min((L.width - 2 * pad) / (maxX - minX), (L.height - 2 * pad) / (maxY - minY));
  const ox = (L.width - (maxX - minX) * k) / 2, oy = (L.height - (maxY - minY) * k) / 2;
  const pos = deputes.map((d) => (d.place && plan.sieges[String(Number(d.place))]) || null);
  if (pos.every(Boolean)) {
    real = pos.map((p, i) => [+(ox + (p![0] - minX) * k - L.seats[i].x).toFixed(1), +(oy + (p![1] - minY) * k - L.seats[i].y).toFixed(1)]);
    // Rayon : un peu moins de la moitié de la distance au plus proche voisin, sur un échantillon.
    const abs = pos.map((p) => [ox + (p![0] - minX) * k, oy + (p![1] - minY) * k]);
    let dmin = Infinity;
    for (let i = 0; i < abs.length; i += 7) for (let j = 0; j < abs.length; j++) if (i !== j) dmin = Math.min(dmin, Math.hypot(abs[i][0] - abs[j][0], abs[i][1] - abs[j][1]));
    realDot = Math.min(L.dot, dmin * 0.46);
  }
}
---
<section class="hemi-block" data-view={v.id}>
  {real && (
    <div class="layout-toggle seg" role="group" aria-label="Disposition">
      <button type="button" data-layout="arcs" aria-pressed="true">Par groupe</button>
      <button type="button" data-layout="reel" aria-pressed="false">Plan réel</button>
    </div>
  )}


  <div class="hemi-grid">
    <figure class="hemi-fig">
      <svg class="hemi" viewBox={`0 0 ${L.width.toFixed(0)} ${L.height.toFixed(0)}`} role="img" aria-label={`Hémicycle de ${deputes.length} sièges : ${v.titre}`}>
        {L.seats.map((s, i) => (
          <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={L.dot.toFixed(2)} data-i={i} style={`fill:${initial[i]}`} />
        ))}
        <text x={L.cx} y={L.cy - 18} text-anchor="middle" class="hemi-total">{deputes.length}</text>
        <text x={L.cx} y={L.cy + 6} text-anchor="middle" class="hemi-sub">députés</text>
      </svg>
      <figcaption class="legend">
        {v.kind === 'groupe' && (
          <ul class="glegend">
            {groupes.map((g) => (
              <li title={g.nom}><i style={`background:${g.couleur}`}></i>{g.sigle} <span class="num muted">{g.effectif}</span></li>
            ))}
          </ul>
        )}
        {v.kind === 'rampe' && (
          <div class="rlegend">
            <div class="ramp"></div>
            <div class="rl"><span>{v.legende?.[0]}</span><span>{v.legende?.[1]}</span></div>
          </div>
        )}
        {v.kind === 'binaire' && (
          <ul class="glegend">
            <li><i style="background:var(--ink-62)"></i>{v.legende?.[0]}</li>
            <li><i style="background:var(--ramp-to)"></i>{v.legende?.[1]}</li>
          </ul>
        )}
      </figcaption>
    </figure>

    <aside class="panel" hidden aria-live="polite">
      <button class="close" type="button" aria-label="Fermer la fiche">×</button>
      <div class="panel-body"></div>
    </aside>
  </div>

  <div class="views" role="toolbar" aria-label="Thématique">
    <div class="seg">
      {VIEWS.map((vw) => (
        <a href={vw.id === 'groupes' ? '/' : `/vue/${vw.id}/`} data-view={vw.id} aria-pressed={vw.id === v.id ? 'true' : 'false'}>{vw.label}</a>
      ))}
    </div>
  </div>

  <div class="finder">
    <label for="find-depute" class="small muted">Trouver un député par son nom</label>
    <input id="find-depute" type="search" placeholder="Ex. Marine Le Pen, Boyard" autocomplete="off" aria-describedby="find-help" />
    <ul class="find-results" role="listbox" hidden></ul>
    <p id="find-help" class="small muted find-empty" hidden></p>
  </div>

  <script type="application/json" class="hemi-data" set:html={JSON.stringify({ real, realDot: +realDot.toFixed(2), dot: +L.dot.toFixed(2), people, groupNames })}></script>
</section>

<script>
  type Person = { s: string; n: string; g: string; c: string | null; a: number | null; f: boolean; p: string | null; l: string | null; m: number | null; r: string | null; am: number; ph: string | null };

  for (const block of document.querySelectorAll<HTMLElement>('.hemi-block')) {
    const data = JSON.parse(block.querySelector('.hemi-data')!.textContent!) as {
      real: [number, number][] | null; realDot: number; dot: number; people: Person[]; groupNames: Record<string, string>;
    };
    const circles = [...block.querySelectorAll<SVGCircleElement>('circle')];
    const panel = block.querySelector<HTMLElement>('.panel')!;
    const body = panel.querySelector<HTMLElement>('.panel-body')!;
    const baseUrl = location.pathname;
    let selected: SVGCircleElement | null = null;

    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

    function open(i: number, push = true) {
      const p = data.people[i];
      selected?.classList.remove('sel');
      selected = circles[i];
      selected.classList.add('sel');
      const rows: [string, string | null][] = [
        ['Groupe', data.groupNames[p.g] ?? p.g],
        ['Circonscription', p.c],
        ['Âge', p.a == null ? null : `${p.a} ans`],
        ['Présence aux votes', p.p],
        ['Vote avec son groupe', p.l],
        ['Législatures', p.m == null ? null : String(p.m)],
        ['Amendements déposés', String(p.am)],
        ['Revenus annexes déclarés', p.r],
      ];
      body.innerHTML = `
        <p class="kicker">${esc(p.g)}</p>
        <h3>${esc(p.n)}</h3>
        <dl>${rows.filter(([, v]) => v).map(([k, v]) => `<dt>${k}</dt><dd>${esc(v!)}</dd>`).join('')}</dl>
        <a class="more" href="/deputes/${p.s}/">Fiche complète et sources →</a>`;
      panel.hidden = false;
      if (push) history.pushState({ seat: i }, '', `/deputes/${p.s}/`);
    }
    function close(push = true) {
      panel.hidden = true;
      selected?.classList.remove('sel');
      selected = null;
      if (push) history.pushState({}, '', baseUrl);
    }
    const svgEl = block.querySelector('svg')!;
    block.querySelectorAll<HTMLButtonElement>('.layout-toggle button').forEach((btn) =>
      btn.addEventListener('click', () => {
        const reel = btn.dataset.layout === 'reel';
        block.querySelectorAll('.layout-toggle button').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
        svgEl.classList.toggle('reel', reel);
        circles.forEach((c, i) => {
          const d = data.real![i];
          c.style.transform = reel ? `translate(${d[0]}px, ${d[1]}px)` : '';
          c.setAttribute('r', String(reel ? data.realDot : data.dot));
        });
      }),
    );
    svgEl.addEventListener('click', (e) => {
      const c = (e.target as Element).closest('circle');
      if (c) open(Number(c.getAttribute('data-i')));
    });
    panel.querySelector('.close')!.addEventListener('click', () => close());
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) close(); });
    window.addEventListener('popstate', (e) => {
      if (e.state?.seat != null) open(e.state.seat, false);
      else close(false);
    });
    // Recherche sur le nom et le prénom uniquement, sans accents ni tirets, mots dans n'importe quel ordre.
    const norm = (x: string) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[-']/g, ' ');
    const index = data.people.map((p) => norm(p.n));
    const input = block.querySelector<HTMLInputElement>('#find-depute')!;
    const list = block.querySelector<HTMLUListElement>('.find-results')!;
    const empty = block.querySelector<HTMLElement>('.find-empty')!;
    input.addEventListener('input', () => {
      const words = norm(input.value.trim()).split(/\s+/).filter(Boolean);
      if (!words.length || input.value.trim().length < 2) { list.hidden = true; empty.hidden = true; return; }
      const hits = index.map((t, i) => (words.every((w) => t.includes(w)) ? i : -1)).filter((i) => i >= 0).slice(0, 8);
      list.innerHTML = hits.map((i) => { const p = data.people[i]; return `<li><button type="button" data-i="${i}">${esc(p.n)} <span>${esc(p.g)}${p.c ? ' · ' + esc(p.c) : ''}</span></button></li>`; }).join('');
      list.hidden = !hits.length;
      empty.hidden = hits.length > 0;
      empty.textContent = hits.length ? '' : `Aucun des 577 députés en exercice ne correspond à « ${input.value.trim()} ». Parlementeur couvre pour l'instant l'Assemblée élue en 2024 : les anciens députés n'y figurent pas encore.`;
    });
    list.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest('button');
      if (!btn) return;
      const i = Number(btn.dataset.i);
      open(i);
      list.hidden = true;
      circles[i].scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
  }
</script>

<style>
  .hemi-block { display: grid; gap: 16px; }
  .views { view-transition-name: views; overflow-x: auto; display: flex; justify-content: center; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  .views .seg { flex-wrap: nowrap; white-space: nowrap; }
  .hemi-grid { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); }
  .hemi-fig { margin: 0; display: grid; gap: 12px; justify-items: center; }
  .hemi-fig .legend { justify-self: stretch; max-width: 900px; margin-inline: auto; width: 100%; }
  .hemi { view-transition-name: hemi; width: 100%; max-width: 900px; margin-inline: auto; height: auto; display: block; touch-action: manipulation; }
  .hemi circle { cursor: pointer; transition: fill 0.35s ease, transform 0.7s cubic-bezier(.4,0,.2,1); }
  .hemi.reel .hemi-total, .hemi.reel .hemi-sub { opacity: 0; }
  .hemi-total, .hemi-sub { transition: opacity .3s; }
  .layout-toggle { justify-self: start; }
  .hemi circle:hover { stroke: var(--ink); stroke-width: 2; }
  .hemi :global(circle.sel) { stroke: var(--ink); stroke-width: 3; }
  .hemi-total { font-family: var(--serif); font-weight: 600; font-size: 52px; fill: var(--ink); }
  .hemi-sub { font-size: 15px; fill: var(--ink-62); }
  .glegend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.85rem; }
  .glegend li { display: inline-flex; align-items: center; gap: 6px; }
  .glegend i { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .rlegend { display: grid; gap: 4px; max-width: 420px; }
  .ramp { height: 10px; border-radius: 2px; background: linear-gradient(90deg, var(--ramp-from), var(--ramp-to)); }
  .rl { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--ink-62); }

  .panel {
    position: fixed; z-index: 20; background: var(--bg); border: 1px solid var(--ink-16);
    box-shadow: 0 12px 40px color-mix(in srgb, var(--ink) 18%, transparent);
    left: 0; right: 0; bottom: 0; border-radius: 14px 14px 0 0; max-height: 72vh; overflow: auto;
    padding: 20px 20px calc(20px + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 900px) {
    .hemi-grid { grid-template-columns: minmax(0, 1fr) 320px; gap: 28px; }
    .panel { position: sticky; top: 16px; inset: auto; align-self: start; border-radius: 8px; box-shadow: none; max-height: none; }
    .hemi-grid:has(.panel[hidden]) { grid-template-columns: minmax(0, 1fr); }
  }
  .close { position: absolute; top: 8px; right: 10px; background: none; border: 0; font-size: 1.6rem; line-height: 1; padding: 6px 10px; color: var(--ink-62); }
  .panel :global(h3) { font-size: 1.5rem; margin-block: 4px 12px; padding-right: 32px; }
  .panel :global(dl) { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0 0 16px; font-size: 0.92rem; }
  .panel :global(dt) { color: var(--ink-62); }
  .panel :global(dd) { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
  .panel :global(.more) { font-weight: 600; }
  .finder { display: grid; gap: 4px; max-width: 480px; width: 100%; margin-inline: auto; position: relative; }
  .find-results { list-style: none; margin: 0; padding: 4px; border: 1px solid var(--ink-16); border-radius: 8px; background: var(--bg); display: grid; }
  .find-results :global(button) { width: 100%; text-align: left; background: none; border: 0; padding: 8px 10px; border-radius: 6px; font-weight: 600; }
  .find-results :global(button:hover), .find-results :global(button:focus-visible) { background: var(--ink-4); }
  .find-results :global(button span) { font-weight: 400; color: var(--ink-62); font-size: 0.85rem; }
  .finder input { font: inherit; padding: 9px 12px; border: 1px solid var(--ink-16); border-radius: 8px; background: var(--bg); color: var(--ink); }
</style>
