---
// Blocs question / réponse sous l'hémicycle. Chaque barre s'ouvre sur la liste des députés concernés.
import type { Block } from '../lib/insights';

interface Props { blocks: Block[] }
const { blocks } = Astro.props;
const fmt = (n: number) => n.toLocaleString('fr-FR');
const R = 42;
const C = 2 * Math.PI * R;

// Valeurs de mise en page calculées ici, pour garder le gabarit simple.
const view = blocks.map((b) => {
  if (b.kind === 'bars') {
    const max = b.max ?? Math.max(...b.rows.map((r) => r.value), 1);
    const inScale = b.marker && b.marker.value <= max;
    return { b: inScale ? b : { ...b, marker: undefined }, max, mk: inScale ? `--mk:${(b.marker!.value / max) * 100}%` : undefined };
  }
  if (b.kind === 'split') {
    const tot = b.parts.reduce((a, p) => a + p.value, 0);
    let acc = 0;
    const arcs = b.parts.map((p) => {
      const len = (p.value / tot) * C;
      const a = { ...p, dash: `${len} ${C - len}`, off: -acc, pct: Math.round((p.value / tot) * 100) };
      acc += len;
      return a;
    });
    return { b, arcs };
  }
  if (b.kind === 'pairs') return { b, max: Math.max(...b.rows.map((r) => r.a + r.b), 1) };
  return { b };
});
---
<div class="insights">
  {view.map(({ b, max, mk, arcs }: any) => (
    <section class="card">
      <h3>{b.question}</h3>
      <p class="answer">{b.answer}</p>

      {b.kind === 'bars' && (
        <div class="bars" style={mk}>
          {b.rows.map((r: any) => (
            r.names && r.names.length ? (
              <details class="row">
                <summary>
                  <span class="lbl">{r.color && <i style={`background:${r.color}`}></i>}{r.label}</span>
                  <span class="track"><span class="fill" style={`width:${(r.value / max) * 100}%;${r.color ? `background:${r.color}` : ''}`}></span>{b.marker && <span class="mk"></span>}</span>
                  <span class="val num">{r.display}</span>
                </summary>
                <ul class="names">{r.names.map((n: any) => <li><a href={`/deputes/${n.s}/`}>{n.n}</a> <span class="muted">{n.g}{n.v ? ` · ${n.v}` : ''}</span></li>)}</ul>
              </details>
            ) : (
              <div class="row static">
                <span class="lbl">{r.color && <i style={`background:${r.color}`}></i>}{r.label}</span>
                <span class="track"><span class="fill" style={`width:${(r.value / max) * 100}%;${r.color ? `background:${r.color}` : ''}`}></span>{b.marker && <span class="mk"></span>}</span>
                <span class="val num">{r.display}</span>
              </div>
            )
          ))}
          {b.marker && <p class="small muted">Trait vertical : {b.marker.label}.</p>}
        </div>
      )}

      {b.kind === 'split' && (
        <div class="split">
          <svg viewBox="0 0 100 100" class="donut" role="img" aria-label={arcs.map((p: any) => `${p.label} ${p.value}`).join(', ')}>
            {arcs.map((p: any) => <circle cx="50" cy="50" r={R} fill="none" stroke={p.color} stroke-width="14" stroke-dasharray={p.dash} stroke-dashoffset={p.off} transform="rotate(-90 50 50)" />)}
          </svg>
          <ul class="parts">
            {arcs.map((p: any) => <li><i style={`background:${p.color}`}></i><b class="num">{fmt(p.value)}</b> {p.label.toLowerCase()} <span class="muted num">({p.pct} %)</span></li>)}
          </ul>
        </div>
      )}

      {b.kind === 'pairs' && (
        <div class="pairs">
          <p class="plegend small"><i style={`background:${b.colors[0]}`}></i>{b.legend[0]} <i style={`background:${b.colors[1]}`}></i>{b.legend[1]}</p>
          {b.rows.map((r: any) => (
            <div class="prow">
              <span class="lbl">{r.color && <i style={`background:${r.color}`}></i>}{r.label}</span>
              <span class="ptrack">
                <span style={`width:${(r.a / max) * 100}%;background:${b.colors[0]}`}></span>
                <span style={`width:${(r.b / max) * 100}%;background:${b.colors[1]}`}></span>
              </span>
              <span class="val num">{r.a} · {r.b}</span>
            </div>
          ))}
        </div>
      )}

      {b.kind === 'svg' && (
        <figure class="fig">
          <Fragment set:html={b.svg.replace('role="img"', `role="img" aria-label="${b.question.replace(/"/g, '&quot;')}"`)} />
          {b.legend && <p class="plegend small">{b.legend.map((l: any) => <><i style={`background:${l.color}`}></i>{l.label} </>)}</p>}
          <p class="pick small" aria-live="polite"></p>
        </figure>
      )}

      {b.kind === 'coalition' && (
        <div class="coal" data-total={b.total}>
          <div class="chips">
            {b.groups.map((g: any) => <button type="button" aria-pressed="false" data-n={g.n} data-sigle={g.sigle} title={g.nom}><i style={`background:${g.color}`}></i>{g.sigle} <span class="num">{g.n}</span></button>)}
          </div>
          <div class="cbar" aria-hidden="true">
            {b.groups.map((g: any) => <span data-sigle={g.sigle} style={`width:0;background:${g.color}`}></span>)}
            <i class="line" style={`left:${((Math.floor(b.total / 2) + 1) / b.total) * 100}%`}></i>
          </div>
          <p class="cstatus" aria-live="polite">Touchez des groupes pour former une majorité.</p>
        </div>
      )}

      {b.kind === 'names' && b.names.length > 0 && (
        b.names.length > 12 ? (
          <details class="longlist"><summary>Voir les {b.names.length} noms</summary>
            <ul class="names">{b.names.map((n: any) => <li><a href={`/deputes/${n.s}/`}>{n.n}</a> <span class="muted">{n.g}{n.v ? ` · ${n.v}` : ''}</span></li>)}</ul>
          </details>
        ) : (
          <ol class="ranked">{b.names.map((n: any) => <li><a href={`/deputes/${n.s}/`}>{n.n}</a> <span class="muted">{n.g}</span>{n.v && <b class="num">{n.v}</b>}</li>)}</ol>
        )
      )}

      {b.note && <p class="note small muted">{b.note}</p>}
    </section>
  ))}
</div>

<script>
  // Toucher un point d'un graphique affiche le député concerné, avec un lien vers sa fiche.
  for (const fig of document.querySelectorAll<HTMLElement>('.insights .fig')) {
    const out = fig.querySelector<HTMLElement>('.pick')!;
    let sel: Element | null = null;
    const svg = fig.querySelector<SVGSVGElement>('svg');
    const pts = svg ? [...svg.querySelectorAll<SVGGraphicsElement>('[data-s]')] : [];
    svg?.addEventListener('click', (e) => {
      // Les points font quelques pixels : on retient le plus proche du doigt, à 22 pixels près.
      let el: Element | null = (e.target as Element).closest('[data-s]');
      if (!el) {
        let best = Infinity;
        for (const p of pts) {
          const r = p.getBoundingClientRect();
          const d = (r.x + r.width / 2 - e.clientX) ** 2 + (r.y + r.height / 2 - e.clientY) ** 2;
          if (d < best) { best = d; el = p; }
        }
        if (best > 22 * 22) el = null;
      }
      if (!el) return;
      sel?.classList.remove('on');
      sel = el;
      el.classList.add('on');
      const d = (el as HTMLElement).dataset;
      out.innerHTML = '';
      const a = document.createElement('a');
      a.href = `/deputes/${d.s}/`;
      a.textContent = d.n!;
      out.append(a, ` · ${d.g}${d.v ? ' · ' + d.v : ''}`);
    });
  }
  // Constructeur de coalition.
  for (const box of document.querySelectorAll<HTMLElement>('.insights .coal')) {
    const total = Number(box.dataset.total);
    const maj = Math.floor(total / 2) + 1;
    const status = box.querySelector<HTMLElement>('.cstatus')!;
    box.querySelectorAll<HTMLButtonElement>('.chips button').forEach((b) =>
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
        let sum = 0;
        const picked: string[] = [];
        box.querySelectorAll<HTMLButtonElement>('.chips button').forEach((x) => {
          const on = x.getAttribute('aria-pressed') === 'true';
          box.querySelector<HTMLElement>(`.cbar span[data-sigle="${x.dataset.sigle}"]`)!.style.width = on ? `${(Number(x.dataset.n) / total) * 100}%` : '0';
          if (on) { sum += Number(x.dataset.n); picked.push(x.dataset.sigle!); }
        });
        status.innerHTML = !picked.length
          ? 'Touchez des groupes pour former une majorité.'
          : sum >= maj
            ? `<b>${picked.join(' + ')} : ${sum} sièges.</b> Majorité absolue atteinte, avec ${sum - maj} sièges d'avance.`
            : `<b>${picked.join(' + ')} : ${sum} sièges.</b> Il manque ${maj - sum} sièges pour la majorité absolue (${maj}).`;
      }),
    );
  }
</script>

<style>
  .insights { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 20px; }
  .card { border-top: 2px solid var(--ink); padding-top: 14px; display: grid; gap: 12px; align-content: start; }
  .card h3 { font-size: 1.3rem; }
  .answer { color: var(--ink-80); }
  .bars { display: grid; gap: 4px; position: relative; }
  .row summary, .row.static { display: grid; grid-template-columns: minmax(90px, 38%) 1fr auto; gap: 10px; align-items: center; font-size: 0.9rem; padding: 8px 0; list-style: none; }
  .row summary::-webkit-details-marker { display: none; }
  .row summary { cursor: pointer; border-radius: 4px; }
  .row summary:hover { background: var(--ink-4); }
  .row summary .lbl::after { content: ' ▸'; color: var(--ink-62); font-size: 0.75em; }
  .row[open] summary .lbl::after { content: ' ▾'; }
  .lbl { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  .lbl i, .parts i, .plegend i { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex: none; margin-right: 6px; }
  .track { position: relative; height: 14px; background: var(--ink-8); border-radius: 2px; overflow: hidden; }
  .fill { display: block; height: 100%; background: var(--ramp-to); border-radius: 2px; }
  .mk { position: absolute; top: 0; bottom: 0; left: var(--mk); width: 2px; background: var(--ink); }
  .val { font-size: 0.85rem; text-align: right; white-space: nowrap; }
  .names { list-style: none; margin: 6px 0 10px; padding: 8px 12px; background: var(--ink-4); border-radius: 6px; columns: 2 200px; column-gap: 20px; font-size: 0.85rem; }
  .names li { break-inside: avoid; padding: 2px 0; }
  .split { display: grid; grid-template-columns: 130px 1fr; gap: 20px; align-items: center; }
  .donut { width: 130px; height: 130px; }
  .parts { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 1.05rem; }
  .parts b { font-family: var(--serif); font-size: 1.6rem; }
  .pairs { display: grid; gap: 6px; }
  .plegend { display: flex; gap: 6px 14px; align-items: center; color: var(--ink-62); }
  .prow { display: grid; grid-template-columns: 84px 1fr 70px; white-space: nowrap; gap: 10px; align-items: center; font-size: 0.9rem; }
  .ptrack { display: flex; height: 14px; gap: 2px; }
  .ptrack span { height: 100%; border-radius: 2px; }
  .ranked { margin: 0; padding-left: 1.4em; display: grid; gap: 4px; font-size: 0.92rem; }
  .ranked b { float: right; font-weight: 600; }
  .fig { margin: 0; display: grid; gap: 6px; }
  .fig :global(svg.chart) { width: 100%; height: auto; display: block; overflow: visible; }
  .fig :global(.tk), .fig :global(.vl) { font-size: 11px; fill: var(--ink-62); font-family: var(--sans); }
  .fig :global(.rl) { font-size: 11.5px; fill: var(--ink); font-weight: 600; font-family: var(--sans); }
  .fig :global(.hd) { font-size: 12px; fill: var(--ink); font-weight: 600; font-family: var(--sans); }
  .fig :global(.an) { font-size: 11px; fill: var(--ink); font-weight: 600; font-family: var(--sans); }
  .fig :global(.qt) { font-size: 10.5px; fill: var(--ink-62); font-style: italic; font-family: var(--sans); }
  .fig :global(.rt) { font-size: 10.5px; fill: var(--ink-62); font-family: var(--sans); }
  .fig :global(.grid) { stroke: var(--ink-8); stroke-width: 1; }
  .fig :global(.base) { stroke: var(--ink-16); stroke-width: 1; }
  .fig :global(.ref) { stroke: var(--ink-62); stroke-width: 1; stroke-dasharray: 3 3; }
  .fig :global(.med) { stroke: var(--ink); stroke-width: 2; }
  .fig :global(.curve) { fill: none; stroke: var(--ramp-to); stroke-width: 2.5; }
  .fig :global(.mk) { fill: var(--ramp-to); }
  .fig :global(.col) { fill: var(--ramp-to); }
  .fig :global([data-s]) { cursor: pointer; }
  .fig :global([data-s].on) { stroke: var(--ink); stroke-width: 2; }
  .pick { min-height: 1.4em; }
  .pick :global(a) { font-weight: 600; }
  .coal { display: grid; gap: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips button { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--ink-16); background: var(--bg); border-radius: 999px; padding: 10px 13px; min-height: 44px; font-size: 0.88rem; }
  .chips button i { width: 10px; height: 10px; border-radius: 50%; }
  .chips button span { color: var(--ink-62); }
  .chips button[aria-pressed='true'] { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); background: var(--ink-4); }
  .cbar { position: relative; display: flex; height: 26px; background: var(--ink-8); border-radius: 4px; overflow: hidden; }
  .cbar span { height: 100%; transition: width 0.35s ease; }
  .cbar .line { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--ink); }
  .cstatus { font-size: 1rem; }
  .longlist summary { cursor: pointer; font-weight: 600; }
  .note { border-left: 2px solid var(--ink-16); padding-left: 10px; }
</style>
